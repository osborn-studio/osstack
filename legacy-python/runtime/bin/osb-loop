#!/usr/bin/env bash
# osb-loop — V1-compatible shim for the TypeScript osstack LoopEngine.
#
# The old implementation hand-ran osb-context -> git diff -> ds-review ->
# ds-verify. The canonical loop now lives behind `osstack loop`; this wrapper
# preserves the legacy entry point and translates the common V1 flags.

set -u

DO_REVIEW=true
DO_VERIFY=true
STRICT=false
OUTPUT=""

usage() {
  cat <<EOF
Usage: osb-loop [--no-review] [--no-verify] [--strict] [--output PATH] [-h]

Compatibility shim for the osstack LoopEngine. It scans the current git diff,
starts or reuses an osstack daemon, and forwards work to:

  osstack loop start --once --source git_diff

Options:
  --no-review     Do not run ds-review as a verifier command.
  --no-verify     Do not run ds-verify as a verifier command.
  --strict        Pass --strict to ds-review and ds-verify when present.
  --output PATH   Write the loop markdown state to PATH.
  -h, --help      Show this help.

Exit code 0 means all completed loop tasks succeeded; exit code 2 means at
least one completed task failed or escalated.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-review) DO_REVIEW=false; shift ;;
    --no-verify) DO_VERIFY=false; shift ;;
    --strict) STRICT=true; shift ;;
    --output)
      [[ $# -ge 2 ]] || { echo "osb-loop: --output requires a value" >&2; exit 2; }
      OUTPUT="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "osb-loop: unknown argument: $1" >&2
      usage >&2
      exit 2 ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

OSSTACK_CMD=()
if [[ -f "$REPO_ROOT/packages/cli/dist/bin.js" ]]; then
  OSSTACK_CMD=(node "$REPO_ROOT/packages/cli/dist/bin.js")
elif command -v osstack >/dev/null 2>&1; then
  OSSTACK_CMD=(osstack)
else
  echo "osb-loop: osstack CLI not found. Run 'pnpm --filter @osstack/cli build' or install osstack on PATH." >&2
  exit 127
fi

STRICT_FLAG=""
$STRICT && STRICT_FLAG=" --strict"

STARTED_DAEMON=false
DAEMON_PID=""
TMP_DIR=""

cleanup() {
  local code=$?
  if [[ "$STARTED_DAEMON" == true && -n "$DAEMON_PID" ]]; then
    kill "$DAEMON_PID" >/dev/null 2>&1 || true
    wait "$DAEMON_PID" >/dev/null 2>&1 || true
  fi
  if [[ -n "$TMP_DIR" ]]; then
    rm -rf "$TMP_DIR" >/dev/null 2>&1 || true
  fi
  exit "$code"
}
trap cleanup EXIT INT TERM

daemon_healthy() {
  "${OSSTACK_CMD[@]}" health >/dev/null 2>&1
}

if ! daemon_healthy; then
  TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/osb-loop.XXXXXX")"
  export OSSTACK_SOCKET="$TMP_DIR/osstack.sock"
  if [[ -z "${OSSTACK_HOME-}" ]]; then
    export OSSTACK_HOME="$TMP_DIR/home"
  fi
  "${OSSTACK_CMD[@]}" serve >"$TMP_DIR/daemon.log" 2>&1 &
  DAEMON_PID="$!"
  STARTED_DAEMON=true

  for _ in $(seq 1 100); do
    if daemon_healthy; then
      break
    fi
    if ! kill -0 "$DAEMON_PID" >/dev/null 2>&1; then
      echo "osb-loop: osstack daemon exited before becoming ready" >&2
      cat "$TMP_DIR/daemon.log" >&2 2>/dev/null || true
      exit 1
    fi
    sleep 0.05
  done

  if ! daemon_healthy; then
    echo "osb-loop: osstack daemon did not become ready" >&2
    cat "$TMP_DIR/daemon.log" >&2 2>/dev/null || true
    exit 1
  fi
fi

CMD=("${OSSTACK_CMD[@]}" loop start --workspace "$PWD" --source git_diff --max-iter 1 --once --interval-ms 250 --json)
[[ -n "$OUTPUT" ]] && CMD+=(--markdown "$OUTPUT")

if $DO_REVIEW; then
  if command -v ds-review >/dev/null 2>&1; then
    mkdir -p reviews/ds-review 2>/dev/null || true
    CMD+=(--verify "mkdir -p reviews/ds-review && (git diff --quiet || git diff | ds-review --output reviews/ds-review/latest.md${STRICT_FLAG})")
  else
    echo "osb-loop: ds-review not found; review verifier skipped" >&2
  fi
fi

if $DO_VERIFY; then
  if command -v ds-verify >/dev/null 2>&1; then
    mkdir -p reviews/ds-verify 2>/dev/null || true
    CMD+=(--verify "mkdir -p reviews/ds-verify && ds-verify --output reviews/ds-verify/latest.md${STRICT_FLAG}")
  else
    echo "osb-loop: ds-verify not found; verify verifier skipped" >&2
  fi
fi

START_OUTPUT="$("${CMD[@]}")"
START_CODE=$?
if [[ $START_CODE -ne 0 ]]; then
  printf '%s\n' "$START_OUTPUT"
  exit "$START_CODE"
fi

LOOP_SESSION_ID="$(
  printf '%s' "$START_OUTPUT" | node -e '
let raw = "";
process.stdin.on("data", (chunk) => raw += chunk);
process.stdin.on("end", () => {
  const parsed = JSON.parse(raw);
  if (typeof parsed.loop_session_id !== "string") process.exit(1);
  console.log(parsed.loop_session_id);
});
'
)"

if [[ -z "$LOOP_SESSION_ID" ]]; then
  echo "osb-loop: loop start did not return loop_session_id" >&2
  printf '%s\n' "$START_OUTPUT" >&2
  exit 1
fi

WAIT_TIMEOUT_SECONDS="${OSB_LOOP_WAIT_TIMEOUT_SECONDS:-3600}"
DEADLINE=$((SECONDS + WAIT_TIMEOUT_SECONDS))
LAST_SESSION=""

while [[ $SECONDS -lt $DEADLINE ]]; do
  LIST_OUTPUT="$("${OSSTACK_CMD[@]}" loop list --json 2>/dev/null || true)"
  LAST_SESSION="$(
    printf '%s' "$LIST_OUTPUT" | LOOP_SESSION_ID="$LOOP_SESSION_ID" node -e '
let raw = "";
process.stdin.on("data", (chunk) => raw += chunk);
process.stdin.on("end", () => {
  try {
    const parsed = JSON.parse(raw);
    const session = Array.isArray(parsed.loops)
      ? parsed.loops.find((loop) => loop.loop_session_id === process.env.LOOP_SESSION_ID)
      : undefined;
    if (session) console.log(JSON.stringify(session));
  } catch {
    process.exit(0);
  }
});
'
  )"
  if [[ -n "$LAST_SESSION" ]]; then
    SESSION_STATUS="$(
      printf '%s' "$LAST_SESSION" | node -e '
let raw = "";
process.stdin.on("data", (chunk) => raw += chunk);
process.stdin.on("end", () => console.log(JSON.parse(raw).status ?? ""));
'
    )"
    if [[ "$SESSION_STATUS" == "stopped" || "$SESSION_STATUS" == "failed" ]]; then
      break
    fi
  fi
  sleep 1
done

if [[ -z "$LAST_SESSION" ]]; then
  echo "osb-loop: loop session was not found: $LOOP_SESSION_ID" >&2
  exit 1
fi

SESSION_STATUS="$(
  printf '%s' "$LAST_SESSION" | node -e '
let raw = "";
process.stdin.on("data", (chunk) => raw += chunk);
process.stdin.on("end", () => console.log(JSON.parse(raw).status ?? ""));
'
)"
if [[ "$SESSION_STATUS" != "stopped" && "$SESSION_STATUS" != "failed" ]]; then
  echo "osb-loop: loop session timed out waiting for completion: $LOOP_SESSION_ID" >&2
  printf '%s\n' "$LAST_SESSION" >&2
  exit 1
fi

"${OSSTACK_CMD[@]}" loop status --daemon --workspace "$PWD"

node -e '
const fs = require("fs");
const path = require("path");
const statePath = path.join(process.cwd(), "LOOP-STATE.json");
const state = JSON.parse(fs.readFileSync(statePath, "utf8"));
const failed = (state.completed_tasks ?? []).some((task) => task.outcome !== "success");
process.exit(failed ? 2 : 0);
'
