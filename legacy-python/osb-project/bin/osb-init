#!/usr/bin/env bash
# osb-init — Initialize an OSBORN-style project skeleton
# Part of the OSBORN Capability Layer (~/.osborn/capabilities/osb-project)

set -euo pipefail

PROJECT_TYPE="webapp"
COMPLEXITY="standard"
FORCE=false

usage() {
  cat <<'USAGE'
Usage: osb-init [--type TYPE] [--complexity LEVEL] [--force]

Options:
  --type TYPE              Project type (default: webapp)
  --complexity LEVEL       Complexity level (default: standard)
  --force                  Overwrite existing files
  -h, --help               Show this help

Generates the standard OSBORN project skeleton:
  docs/ tasks/ reviews/ diagrams/ .agent/ AGENTS.md

Loop:
  docs -> architecture -> tasks -> code -> review -> verify -> test/build/deploy -> changelog
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)
      [[ $# -ge 2 ]] || { echo "osb-init: --type requires a value" >&2; exit 2; }
      PROJECT_TYPE="$2"; shift 2 ;;
    --complexity)
      [[ $# -ge 2 ]] || { echo "osb-init: --complexity requires a value" >&2; exit 2; }
      COMPLEXITY="$2"; shift 2 ;;
    --force)
      FORCE=true; shift ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      echo "osb-init: unknown argument: $1" >&2
      usage >&2
      exit 2 ;;
  esac
done

PROJECT_ROOT="$(pwd)"

echo "osb-init"
echo "  type=$PROJECT_TYPE  complexity=$COMPLEXITY  force=$FORCE"
echo "  root=$PROJECT_ROOT"
echo

create_dir() {
  local d="$1"
  if [[ -d "$d" ]]; then
    echo "SKIP existing dir: $d"
  else
    mkdir -p "$d"
    echo "CREATE dir: $d"
  fi
}

# write_file <path> <<'EOF' ... EOF
# - SKIPs existing files unless --force is set (still consumes stdin so the
#   caller's heredoc is harmless).
write_file() {
  local f="$1"
  local dir
  dir="$(dirname "$f")"
  [[ -d "$dir" ]] || mkdir -p "$dir"

  if [[ -e "$f" && "$FORCE" != "true" ]]; then
    cat >/dev/null   # discard heredoc body
    echo "SKIP existing file: $f"
    return 0
  fi

  if [[ -e "$f" && "$FORCE" == "true" ]]; then
    cat > "$f"
    echo "FORCE overwrite file: $f"
  else
    cat > "$f"
    echo "CREATE file: $f"
  fi
}

# write_generic <path> <title>
write_generic() {
  local f="$1" title="$2"
  local dir
  dir="$(dirname "$f")"
  [[ -d "$dir" ]] || mkdir -p "$dir"

  if [[ -e "$f" && "$FORCE" != "true" ]]; then
    echo "SKIP existing file: $f"
    return 0
  fi

  cat > "$f" <<EOF
# ${title}
## Purpose
TODO
## Key Questions
TODO
## Notes
TODO
EOF

  if [[ "$FORCE" == "true" ]]; then
    echo "FORCE overwrite file: $f"
  else
    echo "CREATE file: $f"
  fi
}

# ------------------------------------------------------------------
# Directories
# ------------------------------------------------------------------
create_dir "docs"
create_dir "tasks"
create_dir "reviews"
create_dir "reviews/ds-review"
create_dir "reviews/ds-verify"
create_dir "diagrams"
create_dir ".agent"

# ------------------------------------------------------------------
# docs/ — specific templates
# ------------------------------------------------------------------
write_file "docs/01_VISION.md" <<'EOF'
# Vision
