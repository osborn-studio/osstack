TODO
EOF

# ------------------------------------------------------------------
# docs/ — generic templates
# ------------------------------------------------------------------
write_generic "docs/03_USER_JOURNEY_AND_USE_CASES.md"      "User Journey and Use Cases"
write_generic "docs/05_DATA_MODEL_AND_KNOWLEDGE_SCHEMA.md" "Data Model and Knowledge Schema"
write_generic "docs/06_API_AND_MCP_CONTRACTS.md"           "API and MCP Contracts"
write_generic "docs/07_STORAGE_AND_FILE_STRUCTURE.md"      "Storage and File Structure"
write_generic "docs/08_SECURITY_AND_PERMISSIONS.md"        "Security and Permissions"
write_generic "docs/09_IMPLEMENTATION_PLAN.md"             "Implementation Plan"
write_generic "docs/11_TEST_AND_EVAL_PLAN.md"              "Test and Eval Plan"
write_generic "docs/12_AGENTS_AND_SKILLS.md"               "Agents and Skills"
write_generic "docs/13_RUNBOOK.md"                          "Runbook"
write_generic "docs/14_DECISIONS.md"                        "Decisions"
write_generic "docs/17_DEPLOYMENT_AND_RELEASE.md"           "Deployment and Release"
write_generic "docs/18_OBSERVABILITY.md"                    "Observability"
write_generic "docs/19_RISK_REGISTER.md"                    "Risk Register"
write_generic "docs/20_ROADMAP.md"                          "Roadmap"

# ------------------------------------------------------------------
# tasks/
# ------------------------------------------------------------------
write_file "tasks/TASKS.md" <<'EOF'
# Tasks
## Backlog
- [ ] TODO
## In Progress
## Done
EOF

write_file "tasks/MILESTONES.md" <<'EOF'
