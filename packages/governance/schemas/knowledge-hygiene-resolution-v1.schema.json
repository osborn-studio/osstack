{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Knowledge Hygiene Resolution v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "diff_id": {
      "type": "string",
      "pattern": "^diff_[a-f0-9]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^khf_[a-f0-9]{64}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "fixed",
        "reviewed_no_change",
        "accepted_risk",
        "suppressed",
        "obsolete"
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "report",
              "scorecard",
              "proof",
              "loop_state",
              "external"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "diff_id",
    "fingerprint",
    "outcome",
    "actor",
    "reason",
    "evidence_refs",
    "resolved_at"
  ],
  "additionalProperties": false
}
