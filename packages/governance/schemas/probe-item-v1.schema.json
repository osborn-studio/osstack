{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Probe Item v1",
  "$comment": "Option uniqueness, selected-option membership, and calibration destination constraints are additionally enforced by @osstack/governance Zod validation.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "item_id": {
          "type": "string",
          "pattern": "^pi_[a-z0-9][a-z0-9_-]{7,63}$"
        },
        "question_id": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9_-]*\\.)+[a-z0-9_-]+\\.v[1-9][0-9]*$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^probe_[a-z0-9][a-z0-9_-]{7,63}$"
        },
        "supersedes_item_id": {
          "type": "string",
          "pattern": "^pi_[a-z0-9][a-z0-9_-]{7,63}$"
        },
        "source_pack": {
          "type": "object",
          "properties": {
            "pack_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pack_id",
            "version"
          ],
          "additionalProperties": false
        },
        "item_kind": {
          "type": "string",
          "enum": [
            "fact",
            "assumption",
            "question",
            "risk"
          ]
        },
        "initial_quadrant": {
          "type": "string",
          "enum": [
            "kk",
            "ku",
            "uk",
            "uu"
          ]
        },
        "current_quadrant": {
          "type": "string",
          "enum": [
            "kk",
            "ku",
            "uk",
            "uu"
          ]
        },
        "doc_type": {
          "type": "string",
          "enum": [
            "product",
            "tech",
            "test"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "user",
            "outcome",
            "scope",
            "data_model",
            "interface",
            "user_flow",
            "failure_mode",
            "performance",
            "security",
            "dependency",
            "migration",
            "rollback",
            "observability",
            "acceptance",
            "test_data",
            "environment",
            "tacit_convention"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "calibration",
            "static_pack",
            "blindspot",
            "interview_followup",
            "prototype_reaction",
            "restatement_diff",
            "mid_build",
            "manual"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "option_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "option_id",
              "label",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 4
        },
        "impact": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ]
        },
        "irreversibility": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ]
        },
        "uncertainty": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ]
        },
        "required": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "file",
                      "artifact"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "kind",
                  "ref"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "url"
                  },
                  "ref": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "kind",
                  "ref"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "symbol",
                      "command_output",
                      "user_statement"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "kind",
                  "ref"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 32
        },
        "destination_hint": {
          "type": "string",
          "enum": [
            "session_profile",
            "prd",
            "technical_design",
            "test_plan",
            "adr",
            "instruction",
            "evaluation_spec",
            "open_questions"
          ]
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "const": "open"
        }
