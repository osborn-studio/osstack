{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Knowledge Hygiene Finding v2",
  "$comment": "Portable-path, surface/location, rule/dimension, and closure-policy refinements are enforced by @osstack/governance Zod validation.",
  "type": "object",
  "properties": {
    "fingerprint": {
      "type": "string",
      "pattern": "^khf_[a-f0-9]{64}$"
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "observed": {
      "type": "object",
      "additionalProperties": {}
    },
    "expected": {
      "type": "object",
      "additionalProperties": {}
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "remediation": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "safe_patch",
            "agent_edit",
            "human_decision"
          ]
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "rule_id": {
      "type": "string",
      "enum": [
        "instruction.canonical_missing",
        "instruction.mirror_missing",
        "instruction.mirror_drift",
        "surface.required_missing",
        "budget.warn_exceeded",
        "budget.error_exceeded",
        "reference.markdown_target_missing",
        "reference.instruction_import_missing",
        "contract.review_required",
        "memory.platform_limit_exceeded",
        "probe.artifact_integrity",
        "probe.destination_missing",
        "probe.deferred_stale",
        "probe.waiver_expired",
        "scan.incomplete",
        "rulebook.managed_context_block",
        "rulebook.narrative_block",
        "rulebook.narrative_density",
        "rulebook.invalid_waiver",
        "dependency.review_due",
        "semantic.narrative",
        "semantic.contradiction",
        "semantic.drift",
        "semantic.memory_overlap",
        "semantic.cross_repository_impact"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "instruction",
        "documentation",
        "memory",
        "dependency"
      ]
    },
    "location": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "repository_scope"
            },
            "repo_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "repo_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "repository"
            },
            "repo_id": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "repo_id",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "adapter"
            },
            "adapter_id": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "adapter_id",
            "uri"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "registry"
            },
            "registry_scope": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "repo_id": {
              "type": "string",
              "minLength": 1
            },
            "obligation_id": {
              "type": "string",
              "minLength": 1
            },
            "edge_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "registry_scope",
            "repo_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "report",
                  "scorecard",
                  "proof",
                  "loop_state",
                  "external"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "evidence_pack"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref",
              "sha256",
              "run_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "obligation"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref",
              "sha256"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "origin": {
      "type": "string",
      "enum": [
        "mechanical",
        "semantic"
      ]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "mechanical",
        "narrative",
        "contradiction",
        "drift",
        "memory_overlap",
        "cross_repository"
      ]
    },
    "closure_policy": {
      "type": "string",
      "enum": [
        "mechanical_sufficient",
        "semantic_confirmation_required"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "repository"
                  },
                  "repo_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "repo_id",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "adapter"
                  },
                  "adapter_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uri": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "adapter_id",
                  "uri"
                ],
                "additionalProperties": false
              }
            ]
          },
          "blob_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_line": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "end_line": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "excerpt": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "blob_sha256",
          "start_line",
          "end_line",
          "text_sha256",
          "excerpt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fingerprint",
    "rule_version",
    "severity",
    "confidence",
    "observed",
    "expected",
    "rationale",
    "remediation",
    "rule_id",
    "surface",
    "location",
    "evidence_refs",
    "origin",
    "dimension",
    "closure_policy",
    "citations"
  ],
  "additionalProperties": false
}
