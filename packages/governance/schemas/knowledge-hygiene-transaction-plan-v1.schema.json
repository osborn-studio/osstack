{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Knowledge Hygiene Transaction Plan v1",
  "$comment": "Content-addressed identity, non-overlap, approval, write-set, expiry, and state invariants are enforced by @osstack/governance Zod validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^khtp_[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "memory",
        "narrative"
      ]
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "partially_approved",
        "approved",
        "applying",
        "applied",
        "recovery_required",
        "recovered",
        "stale",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "repo": {
      "type": "object",
      "properties": {
        "root_realpath": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "root_realpath",
        "fingerprint",
        "repo_id",
        "base_revision"
      ],
      "additionalProperties": false
    },
    "memory_root": {
      "type": "object",
      "properties": {
        "root_realpath": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "root_realpath",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "^khta_[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "const": "move"
              },
              "risk": {
                "type": "string",
                "const": "medium"
              },
              "source": {
                "type": "object",
                "properties": {
                  "root_id": {
                    "type": "string",
                    "enum": [
                      "repo",
                      "memory"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blob_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "start_byte": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_byte": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "bytes_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "start_line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "end_line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "root_id",
                  "path",
                  "blob_sha256",
                  "start_byte",
                  "end_byte",
                  "bytes_sha256",
                  "start_line",
                  "end_line"
                ],
                "additionalProperties": false
              },
              "target": {
                "type": "object",
                "properties": {
                  "root_id": {
                    "type": "string",
                    "enum": [
                      "repo",
                      "memory"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "preimage_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "anchor_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "before",
                      "after",
                      "replace"
                    ]
                  }
                },
                "required": [
                  "root_id",
                  "path",
                  "preimage_sha256",
                  "placement"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "action_id",
              "kind",
              "risk",
              "source",
              "target"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "^khta_[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "const": "compress"
              },
              "risk": {
                "type": "string",
                "const": "high"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "root_id": {
                      "type": "string",
                      "enum": [
                        "repo",
                        "memory"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "blob_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "start_byte": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_byte": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "bytes_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "start_line": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "end_line": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "root_id",
                    "path",
                    "blob_sha256",
                    "start_byte",
                    "end_byte",
                    "bytes_sha256",
                    "start_line",
                    "end_line"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "target": {
                "type": "object",
                "properties": {
                  "root_id": {
                    "type": "string",
                    "enum": [
                      "repo",
                      "memory"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "preimage_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "anchor_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "before",
                      "after",
                      "replace"
                    ]
                  }
                },
                "required": [
                  "root_id",
                  "path",
                  "preimage_sha256",
                  "placement"
                ],
                "additionalProperties": false
              },
              "replacement_utf8": {
                "type": "string"
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "claim_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "root_id": {
                          "type": "string",
                          "enum": [
                            "repo",
                            "memory"
                          ]
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "blob_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "start_byte": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end_byte": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "bytes_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "start_line": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "end_line": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "root_id",
                        "path",
                        "blob_sha256",
                        "start_byte",
                        "end_byte",
                        "bytes_sha256",
                        "start_line",
                        "end_line"
                      ],
                      "additionalProperties": false
                    },
                    "disposition": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "preserved"
                            },
                            "target_bytes_sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "status",
                            "target_bytes_sha256"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "merged"
                            },
                            "target_claim_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "source_claim_ids": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 1
                            }
                          },
                          "required": [
                            "status",
                            "target_claim_id",
                            "source_claim_ids"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "explicitly_discarded"
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "claim_id",
                    "source",
                    "disposition"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "action_id",
              "kind",
              "risk",
              "sources",
              "target",
              "replacement_utf8",
              "claims"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "^khta_[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "const": "delete"
              },
              "risk": {
                "type": "string",
                "const": "high"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "root_id": {
                      "type": "string",
                      "enum": [
                        "repo",
                        "memory"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "blob_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "start_byte": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_byte": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "bytes_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "start_line": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "end_line": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "root_id",
                    "path",
                    "blob_sha256",
                    "start_byte",
                    "end_byte",
                    "bytes_sha256",
                    "start_line",
                    "end_line"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "discards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_bytes_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "source_bytes_sha256",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "action_id",
              "kind",
              "risk",
              "sources",
              "discards"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "write_set": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root_id": {
            "type": "string",
            "enum": [
              "repo",
              "memory"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "preimage_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_utf8": {
            "type": "string"
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          }
        },
        "required": [
          "root_id",
          "path",
          "preimage_sha256",
          "after_sha256",
          "after_utf8",
          "mode"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "target_allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root_id": {
            "type": "string",
            "enum": [
              "repo",
              "memory"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "enum": [
              "documentation",
              "instruction_canonical",
              "memory_original"
            ]
          }
        },
        "required": [
          "root_id",
          "path",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "report",
                  "scorecard",
                  "proof",
                  "loop_state",
                  "external"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "evidence_pack"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref",
              "sha256",
              "run_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "obligation"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref",
              "sha256"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "closure_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "write_set_after_images_match",
          "move_bytes_present_at_target",
          "claim_ledger_complete",
          "discard_ledger_complete",
          "selected_findings_absent"
        ]
      },
      "minItems": 1
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "approval_id": {
            "type": "string",
            "pattern": "^khtap_[a-f0-9]{64}$"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^khta_[a-f0-9]{64}$"
            },
            "minItems": 1
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "local_user_id": {
            "type": "string",
            "minLength": 1
          },
          "tty_consented_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "approval_id",
          "actor",
          "action_ids",
          "revision",
          "approved_at",
          "reason",
          "local_user_id",
          "tty_consented_at"
        ],
        "additionalProperties": false
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "pattern": "^khtr_[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "dry_run",
              "apply",
              "recovery"
            ]
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "applied",
              "already_applied",
              "recovered"
            ]
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "evaluation_only": {
            "type": "boolean"
          }
        },
        "required": [
          "receipt_id",
          "kind",
          "revision",
          "status",
          "manifest_sha256",
          "paths",
          "occurred_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "kind",
    "revision",
    "state",
    "created_at",
    "expires_at",
    "repo",
    "actions",
    "write_set",
    "target_allowlist",
    "evidence_refs",
    "closure_conditions",
    "approvals",
    "receipts"
  ],
  "additionalProperties": false
}
