{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Knowledge Hygiene Finding v1",
  "type": "object",
  "properties": {
    "fingerprint": {
      "type": "string",
      "pattern": "^khf_[a-f0-9]{64}$"
    },
    "rule_id": {
      "type": "string",
      "enum": [
        "instruction.canonical_missing",
        "instruction.mirror_missing",
        "instruction.mirror_drift",
        "surface.required_missing",
        "budget.warn_exceeded",
        "budget.error_exceeded",
        "reference.markdown_target_missing",
        "reference.instruction_import_missing",
        "contract.review_required",
        "memory.platform_limit_exceeded",
        "probe.artifact_integrity",
        "probe.destination_missing",
        "probe.deferred_stale",
        "probe.waiver_expired",
        "scan.incomplete"
      ]
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "enum": [
        "instruction",
        "documentation",
        "memory"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "additionalProperties": {}
    },
    "expected": {
      "type": "object",
      "additionalProperties": {}
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "report",
              "scorecard",
              "proof",
              "loop_state",
              "external"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "remediation": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "safe_patch",
            "agent_edit",
            "human_decision"
          ]
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "fingerprint",
    "rule_id",
    "rule_version",
    "surface",
    "severity",
    "confidence",
    "location",
    "observed",
    "expected",
    "rationale",
    "evidence_refs",
    "remediation"
  ],
  "additionalProperties": false
}
