{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Knowledge Hygiene Review Artifact v1",
  "$comment": "Resolution diff_id equality and fingerprint uniqueness are enforced by @osstack/governance Zod validation and are not expressible in this generated JSON Schema.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "diff_id": {
      "type": "string",
      "pattern": "^diff_[a-f0-9]{64}$"
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "diff_id": {
            "type": "string",
            "pattern": "^diff_[a-f0-9]{64}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^khf_[a-f0-9]{64}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "fixed",
              "reviewed_no_change",
              "accepted_risk",
              "suppressed",
              "obsolete"
            ]
          },
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "human",
                  "agent"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "report",
                    "scorecard",
                    "proof",
                    "loop_state",
                    "external"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "ref"
              ],
              "additionalProperties": false
            }
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "schema_version",
          "diff_id",
          "fingerprint",
          "outcome",
          "actor",
          "reason",
          "evidence_refs",
          "resolved_at"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "diff_id",
    "resolutions"
  ],
  "additionalProperties": false
}
