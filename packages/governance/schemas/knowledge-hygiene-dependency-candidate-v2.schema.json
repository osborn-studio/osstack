{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Knowledge Hygiene Dependency Candidate v2",
  "$comment": "Candidate identity, sorted kinds, evidence identity, and non-self-edge invariants are enforced by @osstack/governance Zod validation.",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^khc_[a-f0-9]{64}$"
    },
    "registry_scope": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_repo_id": {
      "type": "string",
      "minLength": 1
    },
    "upstream_repo_id": {
      "type": "string",
      "minLength": 1
    },
    "downstream_repo_id": {
      "type": "string",
      "minLength": 1
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "api",
          "sdk",
          "env_name",
          "url",
          "symbol",
          "path"
        ]
      },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "report",
                  "scorecard",
                  "proof",
                  "loop_state",
                  "external"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "evidence_pack"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref",
              "sha256",
              "run_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "obligation"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref",
              "sha256"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "candidate_id",
    "registry_scope",
    "source_repo_id",
    "upstream_repo_id",
    "downstream_repo_id",
    "kinds",
    "evidence_refs"
  ],
  "additionalProperties": false
}
