        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "const": "paused"
        },
        "current_question_id": {
          "type": "string",
          "pattern": "^pi_[a-z0-9][a-z0-9_-]{7,63}$"
