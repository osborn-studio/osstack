{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Probe Session v1",
  "$comment": "Question-count, uniqueness, and selected/unselected disjointness constraints are additionally enforced by @osstack/governance Zod validation.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "session_id": {
          "type": "string",
          "pattern": "^probe_[a-z0-9][a-z0-9_-]{7,63}$"
        },
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "worktree_state": {
          "type": "string",
          "enum": [
            "clean",
            "dirty",
            "not_git"
          ]
        },
        "task_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "input",
                  "reference",
                  "prior_ledger"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "external": {
                "type": "boolean"
              },
              "repo_relative_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "kind",
              "label",
              "sha256",
              "external"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "doc_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "product",
              "tech",
              "test"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        },
        "question_pack_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pack_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "pack_id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "selected_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z][a-z0-9_-]*\\.)+[a-z0-9_-]+\\.v[1-9][0-9]*$"
          }
        },
        "unselected_required_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z][a-z0-9_-]*\\.)+[a-z0-9_-]+\\.v[1-9][0-9]*$"
          }
        },
        "depth": {
          "type": "string",
          "enum": [
            "quick",
            "standard",
            "deep"
          ]
        },
        "question_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "questions_presented": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "familiarity": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "enum": [
                "novice",
                "working",
                "expert"
              ]
            },
            "repository": {
              "type": "string",
              "enum": [
                "new",
                "familiar",
                "maintainer"
              ]
            },
            "intent": {
              "type": "string",
              "enum": [
                "sketch",
                "draft",
                "review_ready"
              ]
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "const": "active"
        },
        "current_question_id": {
          "type": "string",
          "pattern": "^pi_[a-z0-9][a-z0-9_-]{7,63}$"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "repo_id",
        "worktree_state",
        "input_refs",
        "doc_types",
        "question_pack_refs",
        "selected_question_ids",
        "unselected_required_question_ids",
        "depth",
        "question_budget",
        "questions_presented",
        "revision",
        "created_at_ms",
        "updated_at_ms",
        "state",
        "current_question_id"
      ],
      "additionalProperties": false
    },
