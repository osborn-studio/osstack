              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "preimage_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "anchor_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "placement": {
