{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Knowledge Hygiene Transaction Action v1",
  "$comment": "Byte-span, content-conservation, claim-ledger, and discard-ledger invariants are enforced by @osstack/governance Zod validation.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^khta_[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "const": "move"
        },
        "risk": {
          "type": "string",
          "const": "medium"
        },
        "source": {
          "type": "object",
          "properties": {
            "root_id": {
              "type": "string",
              "enum": [
                "repo",
                "memory"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "blob_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "start_byte": {
              "type": "integer",
              "minimum": 0
            },
            "end_byte": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "bytes_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "start_line": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "end_line": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "root_id",
            "path",
            "blob_sha256",
            "start_byte",
            "end_byte",
            "bytes_sha256",
            "start_line",
            "end_line"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "root_id": {
              "type": "string",
              "enum": [
                "repo",
                "memory"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "preimage_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "anchor_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "placement": {
              "type": "string",
              "enum": [
                "before",
                "after",
                "replace"
              ]
            }
          },
          "required": [
            "root_id",
            "path",
            "preimage_sha256",
            "placement"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action_id",
        "kind",
        "risk",
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^khta_[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "const": "compress"
        },
        "risk": {
          "type": "string",
