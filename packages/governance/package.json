{
  "name": "@osstack/governance",
  "version": "0.23.0",
  "description": "Deterministic governance verifier for osstack runs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "node ../../scripts/prepare-npm-package.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "check:schemas": "node scripts/generate-schemas.mjs --check"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osborn-studio/osstack.git",
    "directory": "packages/governance"
  },
  "engines": {
    "node": ">=20"
  }
}
