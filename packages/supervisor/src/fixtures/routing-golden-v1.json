{
  "version": 1,
  "dataset_id": "firstmate-routing-regression-v1",
  "cases": [
    {
      "id": "kind-lowest-cost",
      "rationale": "A capability-kind request prefers the lowest-cost available adapter.",
      "entrypoint": "capability",
      "request": {
        "kind": "code.write"
      },
      "adapters": [
        {
          "id": "writer",
          "cost_tier": "high",
          "availability": "available",
          "capabilities": [
            {
              "id": "writer.code.write",
              "kind": "code.write"
            },
            {
              "id": "writer.code.review",
              "kind": "code.review"
            }
          ]
        },
        {
          "id": "cheap",
          "cost_tier": "low",
          "availability": "available",
          "capabilities": [
            {
              "id": "cheap.code.write",
              "kind": "code.write"
            }
          ]
        }
      ],
      "expected": {
        "kind": "selected",
        "adapter_id": "cheap",
        "capability_id": "cheap.code.write",
        "reason": "kind=code.write lowest-cost (low)"
      }
    },
    {
      "id": "exact-capability-before-cost",
      "rationale": "An exact available capability ID takes precedence over cheaper kind matches.",
      "entrypoint": "capability",
      "request": {
        "capability_id": "writer.code.write"
      },
      "adapters": [
        {
          "id": "cheap",
          "cost_tier": "low",
          "availability": "available",
          "capabilities": [
            {
              "id": "cheap.code.write",
              "kind": "code.write"
            }
          ]
        },
        {
          "id": "writer",
          "cost_tier": "high",
          "availability": "available",
          "capabilities": [
            {
              "id": "writer.code.write",
              "kind": "code.write"
            },
            {
              "id": "writer.code.review",
              "kind": "code.review"
            }
          ]
        }
      ],
      "expected": {
        "kind": "selected",
        "adapter_id": "writer",
        "capability_id": "writer.code.write",
        "reason": "exact capability_id match"
      }
    },
