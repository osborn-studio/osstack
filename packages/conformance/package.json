{
  "name": "@osstack/conformance",
  "version": "0.22.0",
  "description": "Kernel consumption conformance suite — proves an external consumer can use the osstack kernel (core/loop/agents) without @osstack/cli. Test-only, never published.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "node ../../scripts/prepare-npm-package.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osstack/agents": "workspace:*",
    "@osstack/core": "workspace:*",
    "@osstack/governance": "workspace:*",
    "@osstack/hermes-adapter": "workspace:*",
    "@osstack/loop": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osborn-studio/osstack.git",
    "directory": "packages/conformance"
  },
  "engines": {
    "node": ">=20"
  }
}
