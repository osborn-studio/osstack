{
  "name": "@osstack/protocol",
  "version": "0.22.0",
  "description": "Stable cross-product / cross-process / cross-agent kernel contracts for osstack (Task, Run, Event, Evidence, Approval, Policy, Agent command envelope) with JSON Schema artifacts and a versioned protocol.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "node ../../scripts/prepare-npm-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "check:schemas": "node scripts/generate-schemas.mjs --check",
    "generate:joint-schemas": "node scripts/generate-joint-schemas.mjs",
    "check:joint-schemas": "node scripts/generate-joint-schemas.mjs --check"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "zod-to-json-schema": "^3.25.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osborn-studio/osstack.git",
    "directory": "packages/protocol"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./joint": {
      "types": "./dist/joint.d.ts",
      "import": "./dist/joint.js",
      "default": "./dist/joint.js"
    },
    "./joint-json": {
      "types": "./dist/joint-json.d.ts",
      "import": "./dist/joint-json.js",
      "default": "./dist/joint-json.js"
    },
    "./*": "./*"
  }
}
