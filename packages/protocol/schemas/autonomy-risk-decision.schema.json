{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Guarded Autonomy Risk Decision",
  "$comment": "Canonical signal ordering and maximum-level consistency are additionally enforced by @osstack/protocol Zod refinements.",
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "preflight",
        "post_diff"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3",
              "R4"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule_id",
          "level",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "phase",
    "level",
    "signals",
    "policy_sha256",
    "input_sha256",
    "decided_at"
  ],
  "additionalProperties": false
}
