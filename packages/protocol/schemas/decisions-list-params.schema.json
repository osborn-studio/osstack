{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSStack Decisions List Params",
  "type": "object",
  "properties": {
    "credential": {
      "type": "string",
      "minLength": 32,
      "maxLength": 4096
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "additionalProperties": false
}
