{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSStack FollowUpCreateParams",
  "$comment": "Local ledger only; parsing does not authorize remote delivery. Runtime validates canonical repository, source binding, revisions and response byte budget.",
  "type": "object",
  "properties": {
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "default_tenant": {
      "type": "boolean",
      "const": true
    },
    "source_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected_source_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740990
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "promise": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "destination_ref": {
      "type": "string",
      "const": "local_operator"
    },
    "resolution_condition": {
      "type": "string",
      "enum": [
        "manual",
        "session_completed"
      ]
    },
    "due_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "repo_path",
    "default_tenant",
    "source_session_id",
    "expected_source_version",
    "idempotency_key",
    "actor",
    "promise",
    "destination_ref",
    "resolution_condition"
  ],
  "additionalProperties": false
}
