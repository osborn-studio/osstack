{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Protocol Agent Command",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "portfolio_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "additionalProperties": {}
    },
    "policy_profile": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "protocol_version",
    "command",
    "actor",
    "input"
  ],
  "additionalProperties": false
}
