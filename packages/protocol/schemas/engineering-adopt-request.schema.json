{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSStack EngineeringAdoptRequest",
  "$comment": "Session adoption pilot shape only. Host authentication, current scope grants, immutable owner, exact source binding, transactional CAS and dispatch fences are runtime checks. No field grants authority.",
  "type": "object",
  "properties": {
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "completion_level": {
      "type": "string",
      "const": "observed_turn",
      "default": "observed_turn"
    }
  },
  "required": [
    "scope_id",
    "task_id",
    "run_id",
    "session_id",
    "goal",
    "request_id"
  ],
  "additionalProperties": false
}
