{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Protocol Approval Request",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "approval_id",
    "action",
    "risk",
    "requested_at"
  ],
  "additionalProperties": false
}
