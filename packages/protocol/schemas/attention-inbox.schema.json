{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSStack Attention Inbox",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "coverage": {
      "type": "string",
      "enum": [
        "covered",
        "degraded",
        "uncovered",
        "unknown"
      ]
    },
    "execution_takeover": {
      "type": "boolean",
      "const": false
    },
    "counts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "maxLength": 80
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "state",
          "total"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "scope_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "decision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "content_hash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "decision": {
            "type": "object",
            "properties": {
              "decision_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "choice_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "required": [
                    "choice_id",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8
              },
              "continuation": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "number",
                    "const": 1
                  },
                  "gate_kind": {
                    "type": "string",
                    "enum": [
                      "phase_continue",
                      "task_authorization",
                      "risk_approval",
                      "external_input"
                    ]
                  },
                  "phase": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "next_action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "evidence_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "evidence_id",
                        "sha256"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 32
                  }
                },
                "required": [
                  "version",
                  "gate_kind",
                  "phase",
                  "next_action",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "decision_id",
              "question",
              "choices"
            ],
            "additionalProperties": false
          },
          "source_version": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "source_missing",
              "source_closed",
              "continued_externally",
              "answer_reserved",
              "answer_uncertain",
              "answer_applied",
              "answer_abandoned",
              "answer_cancelled"
            ]
          },
          "created_at": {
            "type": "number"
          },
          "updated_at": {
            "type": "number"
          },
          "external_message_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item_id",
          "scope_id",
          "session_id",
          "turn_id",
          "decision_id",
          "content_hash",
          "decision",
          "source_version",
          "revision",
          "state",
          "created_at",
          "updated_at",
          "external_message_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "coverage",
    "execution_takeover",
    "counts",
    "next_after",
    "items"
  ],
  "additionalProperties": false
}
