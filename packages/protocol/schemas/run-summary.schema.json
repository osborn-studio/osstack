{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Protocol Run Summary",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "agent_id",
    "outcome",
    "started_at"
  ],
  "additionalProperties": false
}
