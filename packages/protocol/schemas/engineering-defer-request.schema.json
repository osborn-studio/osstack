{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSStack EngineeringDeferRequest",
  "$comment": "Session adoption pilot shape only. Host authentication, current scope grants, immutable owner, exact source binding, transactional CAS and dispatch fences are runtime checks. No field grants authority.",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "wait_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "if_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "wait_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "revisit_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "mission_id",
    "wait_id",
    "if_revision",
    "wait_revision",
    "request_id",
    "revisit_at",
    "reason"
  ],
  "additionalProperties": false
}
