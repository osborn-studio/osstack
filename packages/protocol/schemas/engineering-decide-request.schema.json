{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSStack EngineeringDecideRequest",
  "$comment": "Session adoption pilot shape only. Host authentication, current scope grants, immutable owner, exact source binding, transactional CAS and dispatch fences are runtime checks. No field grants authority.",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "wait_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "if_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "decision_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "session_decision"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000]+$"
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000]+$"
        },
        "item_revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000]+$"
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000]+$"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000]+$"
        },
        "source_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "scope_id",
        "item_id",
        "item_revision",
        "session_id",
        "turn_id",
        "decision_id",
        "source_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "answer": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "choice"
            },
            "choice_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "required": [
            "kind",
            "choice_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "interaction_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    }
  },
  "required": [
    "mission_id",
    "wait_id",
    "if_revision",
    "decision_ref",
    "action_id",
    "answer",
    "interaction_token"
  ],
  "additionalProperties": false
}
