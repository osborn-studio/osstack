{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSStack Decisions Try Status Params",
  "type": "object",
  "properties": {
    "credential": {
      "type": "string",
      "minLength": 32,
      "maxLength": 4096
    },
    "probe_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  },
  "required": [
    "credential",
    "probe_id"
  ],
  "additionalProperties": false
}
