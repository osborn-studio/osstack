{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osstack Protocol Evidence Ref",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "report",
        "scorecard",
        "proof",
        "loop_state",
        "external"
      ]
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "kind",
    "ref"
  ],
  "additionalProperties": false
}
