{
  "name": "@osstack/skill-registry",
  "version": "0.23.0",
  "description": "External skill ingestion: watch GStack/SuperPower/Everything-Claude/Anthropic Skills repos, LLM-normalize to Hermes SKILL.md, propose via PR, batch via npm release.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "node ../../scripts/prepare-npm-package.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osstack/core": "workspace:*",
    "js-yaml": "^4.3.0",
    "zod": "^3.25.76",
    "@osstack/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osborn-studio/osstack.git",
    "directory": "packages/skill-registry"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./source-snapshot": {
      "types": "./dist/source-snapshot.d.ts",
      "import": "./dist/source-snapshot.js",
      "default": "./dist/source-snapshot.js"
    },
    "./*": "./*",
    "./source-adoption": {
      "types": "./dist/source-adoption.d.ts",
      "import": "./dist/source-adoption.js",
      "default": "./dist/source-adoption.js"
    }
  }
}
