{
  "name": "@osstack/cli",
  "version": "0.14.0",
  "description": "OSBORN stack CLI binary — orchestrates dev sub-agents under Hermes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "osstack": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/control-plane.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osstack/agents": "workspace:*",
    "@osstack/autonomy": "workspace:*",
    "@osstack/compliance": "workspace:*",
    "@osstack/config": "workspace:*",
    "@osstack/contracts": "workspace:*",
    "@osstack/core": "workspace:*",
    "@osstack/governance": "workspace:*",
    "@osstack/github": "workspace:*",
    "@osstack/hermes-adapter": "workspace:*",
    "@osstack/knowledge": "workspace:*",
    "@osstack/loop": "workspace:*",
    "@osstack/protocol": "workspace:*",
    "@osstack/skill-registry": "workspace:*",
    "@osstack/skills": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@osstack/supervisor": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gilosbornhello/osstack.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  }
}
