{
  "name": "@osstack/plugins",
  "version": "0.15.0",
  "description": "7 plugin slots (runtime / agent / workspace / tracker / notifier / reviewer / verifier). Each defines a TS interface + PluginModule.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "node ../../scripts/prepare-npm-package.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osstack/core": "workspace:*",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gilosbornhello/osstack.git",
    "directory": "packages/plugins"
  },
  "engines": {
    "node": ">=20"
  }
}
