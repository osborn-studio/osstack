{
  "name": "@osstack/loop",
  "version": "0.21.0",
  "description": "osstack Loop Engineering layer — scheduler, discover, planner, verifier, iterator: the daemon hot loop that turns osstack from a passive task dispatcher into a self-running Loop Engineering system.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "osstack-loop": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "node ../../scripts/prepare-npm-package.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osstack/agents": "workspace:*",
    "@osstack/autonomy": "workspace:*",
    "@osstack/core": "workspace:*",
    "@osstack/github": "workspace:*",
    "@osstack/governance": "workspace:*",
    "@osstack/hermes-adapter": "workspace:*",
    "@osstack/protocol": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osborn-studio/osstack.git",
    "directory": "packages/loop"
  },
  "engines": {
    "node": ">=20"
  }
}
