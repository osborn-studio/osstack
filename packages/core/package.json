{
  "name": "@osstack/core",
  "version": "0.20.0",
  "description": "OSBORN stack core — orchestrator, lifecycle, policy, memory, learning, privacy, observability, knowledge-graph, state, events.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "node ../../scripts/prepare-npm-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@osstack/protocol": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osborn-studio/osstack.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./decision-advice": {
      "types": "./dist/policy/decision-advice.d.ts",
      "import": "./dist/policy/decision-advice.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./graph-recovery": {
      "types": "./dist/state/graph-recovery.d.ts",
      "import": "./dist/state/graph-recovery.js",
      "default": "./dist/state/graph-recovery.js"
    },
    "./graph-artifacts": {
      "types": "./dist/graph/artifact-store.d.ts",
      "import": "./dist/graph/artifact-store.js",
      "default": "./dist/graph/artifact-store.js"
    },
    "./*": "./*",
    "./graph-verification": {
      "types": "./dist/state/graph-verification.d.ts",
      "import": "./dist/state/graph-verification.js"
    }
  }
}
