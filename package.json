{
  "name": "@osstack/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "OSBORN stack (osstack) \u2014 Hermes-resident project manager agent for software development lifecycle. TypeScript daemon + Python Hermes skill wrapper.",
  "repository": "https://github.com/osborn-studio/osstack",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm build && pnpm typecheck:check",
    "typecheck:check": "pnpm -r typecheck",
    "lint": "biome check .",
    "test:method-export": "node --test scripts/export-osstack-methods.test.mjs scripts/method-provenance.test.mjs",
    "export:methods": "node scripts/export-osstack-methods.mjs",
    "prepare:bug-fix-method": "node scripts/prepare-bug-fix-method.mjs",
    "test:bug-fix-method": "node --test scripts/prepare-bug-fix-method.test.mjs",
    "dev": "pnpm --filter @osstack/cli dev",
    "coverage:loop": "pnpm --filter @osstack/loop test:coverage",
    "build:single-binary": "node scripts/build-single-binary.mjs",
    "sign:single-binary": "node scripts/sign-single-binary.mjs",
    "notarize:single-binary": "node scripts/notarize-single-binary.mjs",
    "sbom:single-binary": "node scripts/generate-single-binary-sbom.mjs",
    "package:single-binary": "node scripts/package-single-binary.mjs",
    "publish:single-binary": "node scripts/publish-single-binary-release.mjs",
    "build:knowledge-cloud-catalog": "node scripts/build-knowledge-cloud-publish-catalog.mjs",
    "version:packages": "node scripts/version-packages.mjs",
    "release": "pnpm preflight:npm-bootstrap && node scripts/publish-packages-safely.mjs",
    "preflight:npm-publish": "node scripts/preflight-npm-publish-access.mjs",
    "preflight:npm-bootstrap": "node scripts/preflight-npm-package-bootstrap.mjs --json",
    "preflight:npm-trust": "node scripts/preflight-npm-trusted-publishers.mjs --json",
    "configure:npm-trust": "node scripts/configure-npm-trusted-publishers.mjs",
    "deprecate:npm-broken": "node scripts/deprecate-broken-npm-versions.mjs",
    "smoke:npm-preflight": "node scripts/smoke-npm-preflight-access.mjs",
    "smoke:npm-bootstrap": "node scripts/smoke-npm-package-bootstrap.mjs",
    "smoke:npm-trust": "node scripts/smoke-npm-trusted-publishers.mjs && node scripts/smoke-npm-trust-configuration.mjs",
    "smoke:npm-deprecation": "node scripts/smoke-npm-broken-deprecation.mjs",
    "smoke:npm-publish-order": "node scripts/smoke-npm-publish-order.mjs",
    "smoke:clean-typecheck": "node scripts/smoke-clean-typecheck-contract.mjs",
    "smoke:cli-startup": "pnpm --filter @osstack/cli build && node scripts/bench-cli-startup.mjs",
    "smoke:version-packages": "node scripts/version-packages.mjs --self-test",
    "demo:loop": "pnpm build && node scripts/demo-loop.mjs",
    "demo:loop:daemon": "pnpm build && node scripts/demo-loop-daemon.mjs",
    "smoke:loop": "pnpm build && node scripts/smoke-loop.mjs",
    "smoke:skills-check": "node --test scripts/smoke-skills-check.test.mjs && node scripts/smoke-skills-check.mjs",
    "smoke:engineering-decision": "node --test scripts/smoke-engineering-decision.test.mjs && node scripts/smoke-engineering-decision.mjs",
    "smoke:deliver-proof": "node scripts/smoke-deliver-proof.mjs",
    "smoke:guarded-git": "pnpm --filter @osstack/cli... build && node scripts/smoke-guarded-git.mjs",
    "smoke:real-repo-deliver": "node scripts/smoke-real-repo-deliver.mjs",
    "smoke:knowledge-cloud": "pnpm build && node scripts/smoke-knowledge-cloud.mjs",
    "smoke:knowledge-cloud:deploy": "node scripts/smoke-knowledge-cloud-deploy-assets.mjs",
    "smoke:npm-install": "node scripts/smoke-npm-install.mjs --self-test && node scripts/smoke-npm-install.mjs",
    "smoke:npm-package-artifacts": "node scripts/smoke-npm-package-artifacts.mjs",
    "smoke:npm-registry-skew": "node scripts/smoke-npm-registry-skew.mjs --self-test && node scripts/smoke-npm-registry-skew.mjs",
    "smoke:guarded-deploy": "pnpm --filter @osstack/cli... build && node scripts/smoke-guarded-deploy.mjs",
    "smoke:release-plan": "pnpm --filter @osstack/cli... build && node scripts/smoke-release-plan.mjs",
    "smoke:neat": "pnpm --filter @osstack/cli... build && node scripts/smoke-neat.mjs",
    "test:neat-semantic-live-diagnostic": "node --test scripts/neat-semantic-live-diagnostic.test.mjs",
    "smoke:neat:semantic:live": "pnpm --filter @osstack/cli... build && node scripts/smoke-neat-semantic-live.mjs",
    "smoke:probe": "pnpm --filter @osstack/cli... build && node scripts/smoke-probe.mjs",
    "smoke:probe-skill": "pnpm --filter @osstack/cli... build && node scripts/smoke-probe-skill.mjs",
    "test:soak-kimi-autonomy": "node --test scripts/soak-kimi-autonomy.test.mjs",
    "soak:kimi-autonomy": "node scripts/soak-kimi-autonomy.mjs --duration-days 7 --min-tasks 30",
    "smoke:bun-single-binary": "node scripts/smoke-bun-single-binary.mjs",
    "smoke:single-binary-signing": "node scripts/smoke-single-binary-signing.mjs",
    "smoke:single-binary-release-pack": "node scripts/smoke-single-binary-release-pack.mjs",
    "smoke:single-binary-release-publish": "node scripts/smoke-single-binary-release-publish.mjs",
    "smoke:portable-cli": "node scripts/smoke-portable-cli.mjs",
    "eval:neat-goldens": "pnpm --filter @osstack/cli... build && node scripts/eval-neat-goldens.mjs --check",
    "eval:neat-parity:corpus": "pnpm --filter @osstack/neat-eval build && node packages/neat-eval/dist/cli.js corpus check --lock eval/neat-parity/corpus-lock-v1-v3.json",
    "eval:neat-parity:doctor": "pnpm --filter @osstack/neat-eval build && node packages/neat-eval/dist/cli.js doctor --protocol eval/neat-parity/protocol-v1-v3.json --corpus-lock eval/neat-parity/corpus-lock-v1-v3.json --baseline .osstack/eval-cache/neat-freak-v3-2b4a645",
    "eval:neat-parity:offline": "pnpm --filter @osstack/cli... build && pnpm --filter @osstack/neat-eval build && node scripts/eval-neat-parity-offline.mjs",
    "eval:kimi-review": "pnpm --filter @osstack/agents build && node scripts/eval-kimi-review.mjs --check",
    "smoke:improvement-providers": "node scripts/smoke-improvement-providers.mjs",
    "test:skills-map": "node --test scripts/maintain-skills-check-map.test.mjs",
    "smoke:skills-map": "node scripts/maintain-skills-check-map.mjs",
    "test:method-journey": "node --test scripts/method-verification-journey.test.mjs",
    "smoke:method-journey": "node scripts/method-verification-journey.mjs",
    "test:method-projection": "node --test scripts/project-method-journey-evidence.test.mjs",
    "method:project-evidence": "node scripts/project-method-journey-evidence.mjs",
    "test:method-read": "node --test scripts/read-method-material.test.mjs",
    "read:method": "node scripts/read-method-material.mjs",
    "test:pr-candidate": "node --test scripts/report-pr-candidate.test.mjs",
    "inspect:pr-candidate": "node scripts/report-pr-candidate.mjs",
    "test:pr-stack-candidate": "node --test scripts/report-pr-stack-candidate.test.mjs",
    "inspect:pr-stack-candidate": "node scripts/report-pr-stack-candidate.mjs",
    "test:method-feature-map": "node --test scripts/method-feature-map.test.mjs",
    "inspect:method-feature-map": "node scripts/method-feature-map.mjs",
    "test:method-health": "node --test scripts/method-control-health.test.mjs",
    "inspect:method-health": "node scripts/method-control-health.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "3.2.6",
    "esbuild": "0.28.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "3.2.6",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "@edgeone/pages-blob": "0.0.12"
  }
}
