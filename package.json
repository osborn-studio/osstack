{
  "name": "@osstack/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "OSBORN stack (osstack) \u2014 Hermes-resident project manager agent for software development lifecycle. TypeScript daemon + Python Hermes skill wrapper.",
  "repository": "https://github.com/gilosbornhello/osstack",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "dev": "pnpm --filter @osstack/cli dev",
    "coverage:loop": "pnpm --filter @osstack/loop test:coverage",
    "build:single-binary": "node scripts/build-single-binary.mjs",
    "sign:single-binary": "node scripts/sign-single-binary.mjs",
    "notarize:single-binary": "node scripts/notarize-single-binary.mjs",
    "sbom:single-binary": "node scripts/generate-single-binary-sbom.mjs",
    "package:single-binary": "node scripts/package-single-binary.mjs",
    "publish:single-binary": "node scripts/publish-single-binary-release.mjs",
    "build:knowledge-cloud-catalog": "node scripts/build-knowledge-cloud-publish-catalog.mjs",
    "preflight:npm-publish": "node scripts/preflight-npm-publish-access.mjs",
    "smoke:npm-preflight": "node scripts/smoke-npm-preflight-access.mjs",
    "demo:loop": "pnpm build && node scripts/demo-loop.mjs",
    "demo:loop:daemon": "pnpm build && node scripts/demo-loop-daemon.mjs",
    "smoke:loop": "pnpm build && node scripts/smoke-loop.mjs",
    "smoke:deliver-proof": "node scripts/smoke-deliver-proof.mjs",
    "smoke:real-repo-deliver": "node scripts/smoke-real-repo-deliver.mjs",
    "smoke:knowledge-cloud": "pnpm build && node scripts/smoke-knowledge-cloud.mjs",
    "smoke:knowledge-cloud:deploy": "node scripts/smoke-knowledge-cloud-deploy-assets.mjs",
    "smoke:npm-install": "node scripts/smoke-npm-install.mjs",
    "smoke:release-plan": "pnpm --filter @osstack/cli build && node scripts/smoke-release-plan.mjs",
    "smoke:neat": "pnpm --filter @osstack/cli build && node scripts/smoke-neat.mjs",
    "smoke:bun-single-binary": "node scripts/smoke-bun-single-binary.mjs",
    "smoke:single-binary-signing": "node scripts/smoke-single-binary-signing.mjs",
    "smoke:single-binary-release-pack": "node scripts/smoke-single-binary-release-pack.mjs",
    "smoke:single-binary-release-publish": "node scripts/smoke-single-binary-release-publish.mjs",
    "smoke:portable-cli": "node scripts/smoke-portable-cli.mjs",
    "eval:neat-goldens": "pnpm --filter @osstack/cli build && node scripts/eval-neat-goldens.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "2.1.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "@edgeone/pages-blob": "0.0.12"
  }
}
