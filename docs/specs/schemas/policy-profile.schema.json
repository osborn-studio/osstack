{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstack.dev/specs/schemas/policy-profile.schema.json",
  "title": "Osstack Policy Profile (.osstack/policy.yaml)",
  "type": "object",
  "required": ["schema_version", "mode"],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "type": "string", "enum": ["observe", "propose", "execute"] },
    "auto_apply": { "type": "boolean", "default": false },
    "allowed_auto_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeCategory" },
      "uniqueItems": true
    },
    "requires_approval": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeCategory" },
      "uniqueItems": true
    },
    "forbidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeCategory" },
      "uniqueItems": true
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1 },
        "max_runtime_minutes": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "changeCategory": {
      "type": "string",
      "enum": [
        "docs",
        "tests",
        "lint",
        "source",
        "dependencies",
        "ci",
        "database_migrations",
        "production_deploy",
        "production_config",
        "product_scope",
        "secrets",
        "destructive_git",
        "unreviewed_external_actions"
      ]
    }
  }
}
