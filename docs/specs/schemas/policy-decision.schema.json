{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstack.dev/specs/schemas/policy-decision.schema.json",
  "title": "Osstack Policy Decision Evidence",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": { "type": "string", "enum": ["recorded", "unknown"] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "agent_id", "reason", "event_seq"],
        "properties": {
          "task_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "reason": { "type": "string" },
          "event_seq": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
