{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstack.dev/specs/schemas/repo-config.schema.json",
  "title": "Osstack Repo Config (.osstack/repo.yaml)",
  "oneOf": [
    {
      "$ref": "#/$defs/repoConfigV1"
    },
    {
      "$ref": "#/$defs/repoConfigV2"
    }
  ],
  "$defs": {
    "configString": {
      "type": "string",
      "not": {
        "anyOf": [
          {
            "pattern": "[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]\\s*:\\s*[Bb][Ee][Aa][Rr][Ee][Rr]\\s+\\S+"
          },
          {
            "pattern": "([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy])\\s*(=|:)\\s*\\S+"
          },
          {
            "pattern": "[A-Za-z][A-Za-z0-9+.-]*://[^/\\s:@]+:[^/\\s@]+@"
          },
          {
            "pattern": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----"
          },
          {
            "pattern": "(github_pat_|gh[pousr]_)[A-Za-z0-9_-]{20,}"
          }
        ]
      }
    },
    "nonEmptyConfigString": {
      "allOf": [
        {
          "$ref": "#/$defs/configString"
        },
        {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "core_product",
        "tool",
        "library",
        "reference",
        "archive"
      ]
    },
    "deployChangeType": {
      "type": "string",
      "enum": [
        "docs",
        "tests",
        "lint",
        "source",
        "dependencies",
        "ci",
        "database_migrations",
        "production_config",
        "product_scope"
      ]
    },
    "commandArgv": {
      "$comment": "The runtime Zod contract rejects credential-bearing argv flags such as --token and --password.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/nonEmptyConfigString"
      }
    },
    "deployEnvironmentName": {
      "$comment": "The runtime Zod contract additionally rejects approval, notification, CI, GitHub-token, and private-key control names.",
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyConfigString"
      }
    },
    "autonomyRepoPolicy": {
      "type": "object",
      "required": [
        "max_auto_risk",
        "require_independent_evaluator",
        "max_builder_iterations",
        "max_review_rounds",
        "max_wall_time_minutes",
        "max_no_progress_rounds"
      ],
      "properties": {
        "max_auto_risk": {
          "type": "string",
          "enum": [
            "R1",
            "R2"
          ]
        },
        "require_independent_evaluator": {
          "type": "boolean"
        },
        "max_builder_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_review_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_wall_time_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "max_no_progress_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "gitRepoPolicy": {
      "$comment": "The runtime Zod contract additionally rejects branch_prefix when it equals any protected_branches item.",
      "type": "object",
      "required": [
        "remote",
        "branch_prefix",
        "merge_strategy",
        "auto_merge",
        "protected_branches"
      ],
      "properties": {
        "remote": {
          "$ref": "#/$defs/nonEmptyConfigString"
        },
        "branch_prefix": {
          "$ref": "#/$defs/nonEmptyConfigString"
        },
        "merge_strategy": {
          "const": "squash"
        },
        "auto_merge": {
          "type": "boolean"
        },
        "protected_branches": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "verificationProfiles": {
      "type": "object",
      "required": [
        "quick",
        "standard",
        "release"
      ],
      "properties": {
        "quick": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "standard": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "release": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "freezeWindow": {
      "$comment": "The runtime Zod contract additionally validates timezone against the host IANA time-zone database.",
      "type": "object",
      "required": [
        "timezone",
        "days",
        "start",
        "end"
      ],
      "properties": {
        "timezone": {
          "$ref": "#/$defs/nonEmptyConfigString"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
        }
      },
      "additionalProperties": false
    },
    "deployTargetPolicy": {
      "$comment": "The runtime Zod contract additionally rejects exact overlap between allowed_paths and forbidden_paths.",
      "type": "object",
      "required": [
        "enabled",
        "command",
        "verify_command",
        "health_check",
        "rollback",
        "timeout_ms",
        "health_timeout_ms",
        "allowed_change_types",
        "allowed_paths",
        "allowed_base_branches"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "command": {
          "$ref": "#/$defs/commandArgv"
        },
        "verify_command": {
          "$ref": "#/$defs/commandArgv"
        },
        "health_check": {
          "$ref": "#/$defs/commandArgv"
        },
        "rollback": {
          "$ref": "#/$defs/commandArgv"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1800000
        },
        "health_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "allowed_change_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deployChangeType"
          }
        },
        "allowed_paths": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "forbidden_paths": {
          "$ref": "#/$defs/stringList",
          "default": []
        },
        "allowed_base_branches": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "allowed_environment": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deployEnvironmentName"
          },
          "default": []
        },
        "freeze_windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/freezeWindow"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "deployRepoPolicy": {
      "type": "object",
      "properties": {
        "staging": {
          "$ref": "#/$defs/deployTargetPolicy"
        },
        "production": {
          "$ref": "#/$defs/deployTargetPolicy"
        }
      },
      "additionalProperties": false
    },
    "repoConfigV1": {
      "type": "object",
      "required": [
        "schema_version",
        "product",
        "role",
        "default_branch",
        "verify_command"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "verify_command": {
          "type": "string",
          "minLength": 1
        },
        "build_command": {
          "type": "string"
        },
        "staging_command": {
          "type": "string"
        },
        "production_environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repoConfigV2": {
      "type": "object",
      "required": [
        "schema_version",
        "product",
        "role",
        "default_branch",
        "verify_command",
        "autonomy",
        "git",
        "verification"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "product": {
          "$ref": "#/$defs/nonEmptyConfigString"
        },
        "domain": {
          "$ref": "#/$defs/nonEmptyConfigString"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "default_branch": {
          "$ref": "#/$defs/nonEmptyConfigString"
        },
        "verify_command": {
          "$ref": "#/$defs/nonEmptyConfigString"
        },
        "build_command": {
          "$ref": "#/$defs/configString"
        },
        "staging_command": {
          "$ref": "#/$defs/configString"
        },
        "production_environment": {
          "$ref": "#/$defs/configString"
        },
        "autonomy": {
          "$ref": "#/$defs/autonomyRepoPolicy"
        },
        "git": {
          "$ref": "#/$defs/gitRepoPolicy"
        },
        "verification": {
          "$ref": "#/$defs/verificationProfiles"
        },
        "deploy": {
          "$ref": "#/$defs/deployRepoPolicy"
        }
      },
      "additionalProperties": false
    }
  }
}
