{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstack.dev/specs/schemas/agent-command-result.schema.json",
  "title": "Osstack Agent Command Result",
  "type": "object",
  "required": ["protocol_version", "status"],
  "properties": {
    "protocol_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "status": { "type": "string", "enum": ["ok", "needs_approval", "blocked", "error"] },
    "result": { "type": "object" },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "required_approvals": {
      "type": "array",
      "items": { "$ref": "#/$defs/approvalRequest" }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "reason"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "bad_request",
                "unsupported_protocol_version",
                "unknown_command",
                "policy_denied",
                "needs_approval",
                "not_found",
                "conflict",
                "budget_exceeded",
                "internal"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["report", "scorecard", "proof", "loop_state", "external"] },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "run_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approvalRequest": {
      "type": "object",
      "required": ["approval_id", "action", "risk", "requested_at"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "requested_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
