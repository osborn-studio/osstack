{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstack.dev/specs/schemas/agent-command-result.schema.json",
  "title": "Osstack Agent Command Result",
  "type": "object",
  "required": ["protocol_version", "status"],
  "properties": {
    "protocol_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "status": { "type": "string", "enum": ["ok", "needs_approval", "blocked", "error"] },
    "result": { "type": "object" },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "required_approvals": {
      "type": "array",
      "items": { "$ref": "#/$defs/approvalRequest" }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "reason"],
        "properties": {
          "command": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/errorObject" }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": { "required": ["error"], "properties": { "error": { "$ref": "#/$defs/errorObject" } } }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": {
        "required": ["error"],
        "properties": {
          "error": {
            "allOf": [
              { "$ref": "#/$defs/errorObject" },
              { "properties": { "code": { "enum": ["policy_denied", "budget_exceeded"] } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "needs_approval" } }, "required": ["status"] },
      "then": {
        "required": ["required_approvals"],
        "properties": { "required_approvals": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "errorObject": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "bad_request",
            "unsupported_protocol_version",
            "unknown_command",
            "policy_denied",
            "not_found",
            "conflict",
            "budget_exceeded",
            "internal"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["report", "scorecard", "proof", "loop_state", "external"] },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "run_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approvalRequest": {
      "type": "object",
      "required": ["approval_id", "action", "risk", "requested_at"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "requested_at": { "type": "string", "format": "date-time", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
