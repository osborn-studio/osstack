{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstack.dev/specs/schemas/knowledge-pack.schema.json",
  "title": "Osstack Knowledge Pack",
  "type": "object",
  "required": ["id", "version", "name", "license", "source_kind", "quality_score", "chunks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "source_kind": {
      "type": "string",
      "enum": ["osstack_native", "processed_mit", "curated_external", "internal"]
    },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "scope": {
      "type": "string",
      "enum": ["official", "team", "project"]
    },
    "tenant_id": { "type": "string", "minLength": 1 },
    "taxonomy": {
      "type": "array",
      "items": { "type": "string" }
    },
    "generated_at": { "type": "string" },
    "last_reviewed_at": { "type": "string" },
    "review": {
      "type": "object",
      "required": ["status", "reviewer_id", "reviewed_at", "summary"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["approved", "changes_requested"]
        },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source_attribution": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "path", "sha256", "license", "scope", "imported_at"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "string",
            "enum": ["official", "team", "project"]
          },
          "imported_at": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "title", "body"],
        "properties": {
          "chunk_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
