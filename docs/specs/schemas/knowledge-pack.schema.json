{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstack.dev/specs/schemas/knowledge-pack.schema.json",
  "title": "Osstack Knowledge Pack",
  "type": "object",
  "required": ["id", "version", "name", "license", "source_kind", "quality_score", "chunks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "source_kind": {
      "type": "string",
      "enum": ["osstack_native", "processed_mit", "curated_external", "internal"]
    },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "generated_at": { "type": "string" },
    "source_attribution": {
      "type": "array",
      "items": { "type": "string" }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "title", "body"],
        "properties": {
          "chunk_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
