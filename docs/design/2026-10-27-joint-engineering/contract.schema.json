{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstack.invalid/design/joint-engineering-v1",
  "title": "Proposed boundary fixtures, not runtime authorization",
  "oneOf": [
    {
      "$ref": "#/$defs/source_pin"
    },
    {
      "$ref": "#/$defs/method_binding"
    },
    {
      "$ref": "#/$defs/check_binding"
    },
    {
      "$ref": "#/$defs/trial_permit"
    },
    {
      "$ref": "#/$defs/artifact"
    },
    {
      "$ref": "#/$defs/context_receipt"
    },
    {
      "$ref": "#/$defs/recovery_receipt"
    },
    {
      "$ref": "#/$defs/support_profile"
    },
    {
      "$ref": "#/$defs/method_recipe"
    },
    {
      "$ref": "#/$defs/method_proposal"
    },
    {
      "$ref": "#/$defs/artifact_requirements"
    }
  ],
  "$defs": {
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "source_pin"
        },
        "schema_version": {
          "const": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "subdir": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "schema_version",
        "repository",
        "commit",
        "subdir",
        "content_sha256",
        "license_refs"
      ]
    },
    "method_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "method_binding"
        },
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_config_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "support_profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_snapshot_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipe_version": {
          "type": "string",
          "minLength": 1
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "completion": {
          "const": "local_verified"
        },
        "publication": {
          "const": "none"
        },
        "merge": {
          "const": "none"
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "enum": [
            "trial",
            "qualified"
          ]
        },
        "role_materials": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "builder",
                  "reviewer",
                  "verifier"
                ]
              },
              "method_text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role_required_artifacts_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "role",
              "method_text_sha256",
              "role_required_artifacts_digest"
            ]
          }
        },
        "trial_permit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "schema_version",
        "task_id",
        "proposal_digest",
        "contract_digest",
        "context_config_digest",
        "support_profile_digest",
        "source_snapshot_digest",
        "recipe_version",
        "authorization_ref",
        "completion",
        "publication",
        "merge",
        "binding_digest",
        "mode",
        "role_materials"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "trial"
              }
            }
          },
          "then": {
            "required": [
              "trial_permit_id"
            ]
          },
          "else": {
            "properties": {
              "trial_permit_id": false
            }
          }
        }
      ]
    },
    "check_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "check_binding"
        },
        "schema_version": {
          "const": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "primary_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "role": {
                "enum": [
                  "reproduce",
                  "regression",
                  "acceptance"
                ]
              },
              "registry_ref": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "role",
              "registry_ref",
              "required"
            ]
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "kind",
        "schema_version",
        "repository",
        "primary_id",
        "checks"
      ]
    },
    "trial_permit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "trial_permit"
        },
        "schema_version": {
          "const": 1
        },
        "permit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuer_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "candidate_method_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "support_profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "max_wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        },
        "issued_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scope": {
          "const": "trusted_isolated_development_trial"
        },
        "production_qualified": {
          "const": false
        },
        "max_root_runs": {
          "const": 1
        },
        "root_effect_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "max_adapter_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_cost_microusd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "schema_version",
        "permit_id",
        "issuer_ref",
        "authorization_ref",
        "candidate_method_digest",
        "contract_digest",
        "support_profile_digest",
        "repository",
        "max_wall_ms",
        "issued_at_ms",
        "expires_at_ms",
        "scope",
        "production_qualified",
        "max_root_runs",
        "root_effect_id",
        "binding_digest",
        "max_adapter_invocations",
        "max_actions"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "schema_version": {
          "const": 1
        },
        "artifact_kind": {
          "enum": [
            "intent_frame",
            "reproduction",
            "candidate_checks",
            "independent_review",
            "cleanup_receipt"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "effect_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_head": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "head": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "tree": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "diff_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "workspace_state_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "base_head",
            "head",
            "tree",
            "diff_sha256",
            "workspace_state_sha256"
          ]
        },
        "producer_role": {
          "type": "string",
          "minLength": 1
        },
        "host_record_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "identity_assurance": {
          "enum": [
            "reported",
            "host_authenticated"
          ]
        },
        "artifact_phase": {
          "enum": [
            "intent",
            "baseline",
            "candidate",
            "cleanup"
          ]
        },
        "scenario_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "check_registry_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseline_artifact_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resource_ledger_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "schema_version",
        "artifact_kind",
        "task_id",
        "run_id",
        "effect_id",
        "binding_digest",
        "producer_role",
        "host_record_ref",
        "content_sha256",
        "bytes",
        "identity_assurance",
        "artifact_phase"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "intent_frame"
              }
            },
            "required": [
              "artifact_kind"
            ]
          },
          "then": {
            "properties": {
              "artifact_phase": {
                "const": "intent"
              },
              "candidate": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "reproduction"
              }
            },
            "required": [
              "artifact_kind"
            ]
          },
          "then": {
            "properties": {
              "artifact_phase": {
                "const": "baseline"
              }
            },
            "required": [
              "candidate",
              "scenario_digest",
              "environment_digest",
              "check_registry_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "candidate_checks"
              }
            },
            "required": [
              "artifact_kind"
            ]
          },
          "then": {
            "properties": {
              "artifact_phase": {
                "const": "candidate"
              }
            },
            "required": [
              "candidate",
              "scenario_digest",
              "environment_digest",
              "check_registry_digest",
              "baseline_artifact_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "independent_review"
              }
            },
            "required": [
              "artifact_kind"
            ]
          },
          "then": {
            "properties": {
              "artifact_phase": {
                "const": "candidate"
              }
            },
            "required": [
              "candidate",
              "scenario_digest",
              "environment_digest",
              "check_registry_digest",
              "baseline_artifact_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "cleanup_receipt"
              }
            },
            "required": [
              "artifact_kind"
            ]
          },
          "then": {
            "properties": {
              "artifact_phase": {
                "const": "cleanup"
              },
              "candidate": false
            },
            "required": [
              "resource_ledger_ref"
            ]
          }
        }
      ]
    },
    "context_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "context_receipt"
        },
        "schema_version": {
          "const": 2
        },
        "phase": {
          "enum": [
            "prepared",
            "adapter_observed"
          ]
        },
        "evidence_boundary": {
          "const": "agent_task_prompt_not_provider_wire"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_config_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "token_window_qualification": {
          "const": "unqualified"
        },
        "role": {
          "enum": [
            "builder",
            "reviewer",
            "verifier"
          ]
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role_required_artifacts_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "phase",
        "evidence_boundary",
        "task_id",
        "run_id",
        "session_id",
        "binding_digest",
        "contract_digest",
        "context_config_digest",
        "method_text_sha256",
        "method_bytes",
        "prompt_sha256",
        "prompt_bytes",
        "role_required_artifacts_digest",
        "token_window_qualification",
        "role",
        "proposal_digest"
      ]
    },
    "recovery_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "recovery_receipt"
        },
        "schema_version": {
          "const": 1
        },
        "effect_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding_generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "schema_spec_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "support_profile_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "proof_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "operator_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decision": {
          "enum": [
            "preserve_unknown",
            "proven_not_started",
            "proven_stopped",
            "applied_observed"
          ]
        },
        "target": {
          "enum": [
            "home",
            "broker"
          ]
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "target_home_id": {
          "type": "string",
          "minLength": 1
        },
        "recovery_build_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prior_phase": {
          "enum": [
            "reserved",
            "dispatch_committed",
            "legacy_unknown",
            "broker_unknown"
          ]
        },
        "if_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actual_target_schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ddl_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixture_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "cancelled_before_dispatch",
                  "invocation_contained",
                  "applied_completion"
                ]
              },
              "evidence_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "producer_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "effect_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "subject_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "broker_identity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "broker_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "lease_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "schema": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "owner_generation": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "broker_id",
                  "lease_id",
                  "schema",
                  "owner_generation"
                ]
              }
            },
            "required": [
              "type",
              "evidence_digest",
              "producer_ref",
              "subject_digest"
            ]
          }
        },
        "subject": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "effect"
                },
                "home_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "effect_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "kind",
                "home_id",
                "effect_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "attention_action"
                },
                "home_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "mission_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "action_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "message_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "kind",
                "home_id",
                "mission_id",
                "action_id",
