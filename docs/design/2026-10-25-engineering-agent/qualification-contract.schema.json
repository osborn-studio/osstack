{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSStack qualification record protocol draft v1",
  "$comment": "Shape only. Trusted signature, fetched evidence hashes, issuer role, binding, expiry/revocation, required scenario set and activation authorization MUST be checked by the future runtime verifier. This file provides no production qualification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capability_id": {
          "type": "string",
          "pattern": "^FM-(0[1-9]|1[0-9]|2[0-4])$"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "os": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "architecture": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "filesystem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "isolation_profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "daemon_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "adapter_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "executor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "executor_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "template_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "template_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "recovery_mode": {
              "enum": [
                "query_and_deduplicate",
                "stop_and_reconcile"
              ]
            },
            "host_identity_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "os",
            "architecture",
            "filesystem",
            "isolation_profile",
            "daemon_version",
            "adapter_id",
            "adapter_version",
            "provider",
            "model",
            "executor_id",
            "executor_version",
            "template_id",
            "template_version",
            "recovery_mode",
            "host_identity_sha256"
          ]
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "target_code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "behavior_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "level": {
          "enum": [
            "contract_tested",
            "host_verified",
            "journey_verified"
          ]
        },
        "evidence_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenario_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "checker_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "checker_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "unknown",
                  "not_run"
                ]
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "subject_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "scenario_id",
              "checker_id",
              "checker_version",
              "result",
              "artifact_sha256",
              "subject_sha256"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 100
        },
        "issuer_role": {
          "enum": [
            "ci_verifier",
            "host_qualifier",
            "journey_verifier"
          ]
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "signer_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "required_scenario_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prerequisite_record_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "record_id",
        "capability_id",
        "profile",
        "candidate_sha",
        "target_code_sha256",
        "behavior_contract_sha256",
        "source_manifest_sha256",
        "policy_profile_sha256",
        "registry_sha256",
        "level",
        "evidence_bundle_sha256",
        "evidence_refs",
        "limitations",
        "issuer_role",
        "issued_at",
        "expires_at",
        "revocation_epoch",
        "signer_key_id",
        "required_scenario_set_sha256",
        "prerequisite_record_sha256"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "algorithm",
        "value_base64"
      ]
    }
  },
  "required": [
    "schema_version",
    "canonicalization",
    "payload",
    "signature"
  ]
}
