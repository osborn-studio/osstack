diff --git a/packages/github/src/pr-candidate-snapshot.test.ts b/packages/github/src/pr-candidate-snapshot.test.ts
new file mode 100644
index 00000000..6925ee9a
--- /dev/null
+++ b/packages/github/src/pr-candidate-snapshot.test.ts
@@ -0,0 +1,210 @@
+import { describe, expect, it } from 'vitest';
+import { inspectPrCandidate } from './pr-candidate-snapshot.js';
+import type { DeliveryCommandRunner, DeliveryCommandResult } from './delivery.js';
+
+const H = 'a'.repeat(40), B = 'b'.repeat(40);
+const input = { repo: 'owner/repo', pr: 7, requiredChecks: ['test'] };
+const facts = (overrides = {}) => ({ data: { repository: { nameWithOwner: 'owner/repo', pullRequest: {
+  number: 7, url: 'https://github.com/owner/repo/pull/7', state: 'OPEN', isDraft: false,
+  headRefOid: H, baseRefOid: B, headRefName: 'feature', baseRefName: 'main',
+  mergeable: 'MERGEABLE', mergeStateStatus: 'CLEAN', reviewDecision: 'APPROVED', ...overrides,
+} } } });
+const check = (overrides = {}) => ({ __typename: 'CheckRun', id: 'check-1', name: 'test', status: 'COMPLETED', conclusion: 'SUCCESS', detailsUrl: null, ...overrides });
+const page = (nodes: unknown[], cursor: string | null = null) => ({ nodes, pageInfo: { hasNextPage: cursor !== null, endCursor: cursor } });
+const checks = (nodes: unknown[] = [check()], cursor: string | null = null, oid = H) => ({ data: { repository: {
+  nameWithOwner: 'owner/repo', object: { oid, statusCheckRollup: { contexts: page(nodes, cursor) } },
+} } });
+const threads = (nodes: unknown[] = [], cursor: string | null = null) => ({ data: { repository: {
+  nameWithOwner: 'owner/repo', pullRequest: { number: 7, reviewThreads: page(nodes, cursor) },
+} } });
+function scripted(responses: unknown[]) {
+  const calls: { command: string; args: readonly string[]; timeoutMs: number }[] = [];
+  const runner: DeliveryCommandRunner = { async run(command, args, options) {
+    calls.push({ command, args, timeoutMs: options.timeoutMs });
+    const response = responses.shift();
+    if (response instanceof Error) throw response;
+    if (response === undefined) throw new Error('unexpected call');
+    if (typeof response === 'object' && response !== null && 'commandResult' in response) return response.commandResult as DeliveryCommandResult;
+    return { stdout: JSON.stringify(response), stderr: '', exitCode: 0 };
+  } };
+  return { runner, calls };
+}
+const stable = () => [facts(), checks(), threads(), facts()];
+
+describe('one bounded candidate observation', () => {
+  it('reports a stable observed clear candidate without granting authority', async () => {
+    const { runner, calls } = scripted(stable());
+    const { snapshot, queries, raw } = await inspectPrCandidate(input, runner);
+    expect(snapshot.summary).toBe('no_observed_blocker');
+    expect(snapshot.merge_authorized).toBe(false);
+    expect(snapshot.binding.status).toBe('stable');
+    expect(snapshot.forge_policy_coverage).toBe('not_collected');
+    expect(queries).toHaveLength(4); expect(raw).toHaveLength(4);
+    expect(calls.every(c => c.command === 'gh' && c.args[0] === 'api' && c.args[1] === 'graphql' && c.timeoutMs <= 10000)).toBe(true);
+    expect(calls.flatMap(c => c.args).join(' ')).not.toMatch(/mutation|--watch|comments\(/);
+  });
+  it.each([{ headRefOid: 'c'.repeat(40) }, { baseRefOid: 'c'.repeat(40) }, { headRefName: 'renamed' }])('does not apply old green after identity changes %j', async change => {
+    const { runner } = scripted([facts(), checks(), threads(), facts(change)]);
+    expect((await inspectPrCandidate(input, runner)).snapshot.summary).toBe('candidate_changed');
+  });
+  it('rejects expected pins but retains actual observations', async () => {
+    const { runner } = scripted(stable());
+    expect((await inspectPrCandidate({ ...input, expectedHead: 'd'.repeat(40), expectedBase: B }, runner)).snapshot.summary).toBe('candidate_changed');
+  });
+  it('preserves conflict, failed check and unresolved outdated thread together', async () => {
+    const { runner } = scripted([facts(), checks([check({ conclusion: 'FAILURE' })]), threads([{ id: 't1', isResolved: false, isOutdated: true, path: 'x.ts', line: 1 }]), facts({ mergeable: 'CONFLICTING', mergeStateStatus: 'DIRTY', reviewDecision: 'CHANGES_REQUESTED' })]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.summary).toBe('blocked');
+    expect(snapshot.blockers).toEqual(expect.arrayContaining(['check_failure', 'unresolved_threads', 'changes_requested', 'merge_conflict']));
+  });
+  it.each(['SKIPPED', 'NEUTRAL', null, 'FUTURE_VALUE'])('does not call %s a successful required check', async conclusion => {
+    const { runner } = scripted([facts(), checks([check({ conclusion })]), threads(), facts()]);
+    expect((await inspectPrCandidate(input, runner)).snapshot.summary).toBe('unknown');
+  });
+  it('keeps a failed check visible beside a missing required name', async () => {
+    const { runner } = scripted([facts(), checks([check({ conclusion: 'FAILURE' })]), threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate({ ...input, requiredChecks: ['test', 'missing'] }, runner);
+    expect(snapshot.summary).toBe('blocked'); expect(snapshot.checks.missing_required).toEqual(['missing']);
+  });
+  it('does not infer policy from an unspecified required list', async () => {
+    const { runner } = scripted(stable());
+    expect((await inspectPrCandidate({ repo: input.repo, pr: 7 }, runner)).snapshot.summary).toBe('unknown');
+  });
+  it('rejects duplicate names as ambiguous even when both are green', async () => {
+    const { runner } = scripted([facts(), checks([check(), check({ id: 'check-2' })]), threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.ambiguous_required).toEqual(['test']);
+    expect(snapshot.summary).toBe('unknown');
+    expect(snapshot.unknowns).toContain('required_checks_ambiguous');
+  });
+  it('reads the unresolved thread on page two', async () => {
+    const { runner } = scripted([facts(), checks(), threads([{ id: 'resolved', isResolved: true, isOutdated: false, path: 'a', line: null }], 'next'), threads([{ id: 'late', isResolved: false, isOutdated: false, path: 'b', line: 4 }]), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.review.unresolved.map(t => t.id)).toEqual(['late']); expect(snapshot.summary).toBe('blocked');
+  });
+  it('caps three pages and retains partial rows without claiming completeness', async () => {
+    const { runner, calls } = scripted([facts(), checks([check()], 'a'), checks([], 'b'), checks([], 'c'), threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.complete).toBe(false); expect(snapshot.checks.issue).toBe('page_limit');
+    expect(snapshot.summary).toBe('unknown'); expect(calls).toHaveLength(6);
+  });
+  it('detects a repeated cursor', async () => {
+    const { runner } = scripted([facts(), checks([check()], 'a'), checks([], 'a'), threads(), facts()]);
+    expect((await inspectPrCandidate(input, runner)).snapshot.checks.issue).toBe('cursor_progress');
+  });
+  it('does not use check rows from another commit', async () => {
+    const { runner } = scripted([facts(), checks([check()], null, 'c'.repeat(40)), threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.rows).toEqual([]); expect(snapshot.summary).toBe('unknown');
+  });
+  it('uses the latest review decision with stable candidate identity', async () => {
+    const { runner } = scripted([facts(), checks(), threads(), facts({ reviewDecision: 'REVIEW_REQUIRED' })]);
+    expect((await inspectPrCandidate(input, runner)).snapshot.summary).toBe('waiting');
+  });
+  it.each([null, { errors: [{ message: 'denied' }], ...facts() }, { data: { repository: null } }])('initial unavailable data is not a clear report %j', async response => {
+    const { runner, calls } = scripted([response]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.initial).toBe(null); expect(snapshot.summary).toBe('unknown'); expect(calls).toHaveLength(1);
+  });
+  it('final transport failure keeps initial scoped data but binding unknown', async () => {
+    const { runner } = scripted([facts(), checks(), threads(), new Error('transport')]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.binding.status).toBe('unknown'); expect(snapshot.summary).toBe('unknown');
+    expect(snapshot.checks.rows).toHaveLength(1);
+  });
+  it('the whole budget stops calls while retaining prior observations', async () => {
+    const { runner, calls } = scripted([facts()]);
+    const times = [0, 1, 2, 3];
+    const { snapshot, queries, raw } = await inspectPrCandidate(input, runner, () => times.shift() ?? 90000);
+    expect(snapshot.summary).toBe('unknown'); expect(calls).toHaveLength(1);
+    expect(snapshot.initial).toEqual(facts().data.repository.pullRequest);
+    expect(snapshot.final).toBe(null); expect(snapshot.binding.status).toBe('unknown');
+    expect(snapshot.checks.issue).toBe('budget_exhausted');
+    expect(snapshot.review.threads.issue).toBe('budget_exhausted');
+    expect(snapshot.unknowns).toContain('final_identity_unavailable');
+    expect(queries).toHaveLength(1);
+    expect(queries[0]).toMatchObject({ label: 'initial', exit_code: 0, issue: null });
+    expect(raw).toEqual([{ label: 'initial', stdout: JSON.stringify(facts()), stderr: '' }]);
+  });
+
+  it.each([
+    ['SUCCESS', 'success', 'no_observed_blocker'], ['FAILURE', 'failure', 'blocked'],
+    ['ERROR', 'failure', 'blocked'], ['PENDING', 'pending', 'waiting'], ['EXPECTED', 'unknown', 'unknown'],
+  ] as const)('maps StatusContext %s independently of CheckRun fields', async (state, expectedState, summary) => {
+    const context = { __typename: 'StatusContext', id: 'status-1', context: 'test', state, targetUrl: null };
+    const { runner } = scripted([facts(), checks([context]), threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.rows[0]).toMatchObject({ name: 'test', state: expectedState, raw: context });
+    expect(snapshot.checks.missing_required).toEqual([]);
+    expect(snapshot.summary).toBe(summary);
+    if (state === 'PENDING') expect(snapshot.waiting).toContain('checks_pending');
+  });
+  it('reports a queued CheckRun with no conclusion as waiting', async () => {
+    const { runner } = scripted([facts(), checks([check({ status: 'QUEUED', conclusion: null })]), threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.rows[0]?.state).toBe('pending');
+    expect(snapshot.waiting).toContain('checks_pending'); expect(snapshot.summary).toBe('waiting');
+  });
+  it('a missing required check alone cannot clear a stable candidate', async () => {
+    const { runner } = scripted([facts(), checks([]), threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.complete).toBe(true); expect(snapshot.checks.missing_required).toEqual(['test']);
+    expect(snapshot.blockers).toEqual([]); expect(snapshot.summary).toBe('unknown');
+  });
+  it('matching expected head and base retain a stable observed result', async () => {
+    const { runner } = scripted(stable());
+    const { snapshot } = await inspectPrCandidate({ ...input, expectedHead: H, expectedBase: B }, runner);
+    expect(snapshot.binding).toMatchObject({ status: 'stable', head: H, base: B, expected_head: H, expected_base: B });
+    expect(snapshot.summary).toBe('no_observed_blocker'); expect(snapshot.merge_authorized).toBe(false);
+  });
+  it.each([
+    { issue: 'command_failed', stdout: 'fixture failure', stderr: 'denied', exitCode: 1 },
+    { issue: 'response_size', stdout: 'x'.repeat(1048577), stderr: '', exitCode: 0 },
+    { issue: 'invalid_json', stdout: 'not JSON', stderr: '', exitCode: 0 },
+    { issue: 'repository_mismatch', stdout: JSON.stringify({ data: { repository: { nameWithOwner: 'other/repo' } } }), stderr: '', exitCode: 0 },
+  ])('retains raw $issue response but cannot use it as checks', async ({ issue, ...commandResult }) => {
+    const { runner } = scripted([facts(), { commandResult }, threads(), facts()]);
+    const { snapshot, queries, raw } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.complete).toBe(false); expect(snapshot.checks.issue).toBe(issue);
+    expect(snapshot.checks.rows).toEqual([]); expect(snapshot.summary).toBe('unknown');
+    expect(queries[1]).toMatchObject({ label: 'checks-1', issue, exit_code: commandResult.exitCode });
+    expect(raw[1]).toEqual({ label: 'checks-1', stdout: commandResult.stdout, stderr: commandResult.stderr });
+    expect(snapshot.initial?.headRefOid).toBe(H); expect(snapshot.final?.headRefOid).toBe(H);
+  });
+  it('duplicate check IDs across pages keep the first row but invalidate completeness', async () => {
+    const { runner } = scripted([facts(), checks([check()], 'next'), checks([check()]), threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.issue).toBe('duplicate_id'); expect(snapshot.checks.rows).toHaveLength(1);
+    expect(snapshot.checks.complete).toBe(false); expect(snapshot.summary).toBe('unknown');
+  });
+  it('thread pages from the wrong PR cannot establish zero unresolved threads', async () => {
+    const wrong = threads(); wrong.data.repository.pullRequest.number = 8;
+    const { runner } = scripted([facts(), checks(), wrong, facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.review.threads.issue).toBe('pr_mismatch'); expect(snapshot.review.threads.complete).toBe(false);
+    expect(snapshot.summary).toBe('unknown');
+  });
+  it('hasNextPage without a cursor preserves rows but cannot establish completeness', async () => {
+    const wrong = checks(); wrong.data.repository.object.statusCheckRollup.contexts.pageInfo.hasNextPage = true;
+    const { runner, calls } = scripted([facts(), wrong, threads(), facts()]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.checks.issue).toBe('cursor_progress'); expect(snapshot.checks.rows).toHaveLength(1);
+    expect(snapshot.checks.complete).toBe(false); expect(snapshot.summary).toBe('unknown'); expect(calls).toHaveLength(4);
+  });
+  it.each(['MERGED', 'CLOSED'])('observes terminal %s without erasing independent blockers or authorizing an action', async state => {
+    const { runner } = scripted([facts(), checks([check({ conclusion: 'FAILURE' })]), threads(), facts({ state })]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.summary).toBe(state.toLowerCase()); expect(snapshot.blockers).toContain('check_failure');
+    expect(snapshot.merge_authorized).toBe(false);
+  });
+  it('null review decision is unknown even with successful checks', async () => {
+    const { runner } = scripted([facts(), checks(), threads(), facts({ reviewDecision: null })]);
+    const { snapshot } = await inspectPrCandidate(input, runner);
+    expect(snapshot.unknowns).toContain('review_decision_unknown'); expect(snapshot.summary).toBe('unknown');
+  });
+  it.each([{ repo: '-bad/repo' }, { pr: 0 }, { expectedHead: H }, { requiredChecks: ['test', 'test'] }])('invalid input never invokes forge %j', async change => {
+    const { runner, calls } = scripted([]);
+    await expect(inspectPrCandidate({ ...input, ...change }, runner)).rejects.toThrow('invalid_input');
+    expect(calls).toHaveLength(0);
+  });
+});
diff --git a/packages/github/src/pr-candidate-snapshot.ts b/packages/github/src/pr-candidate-snapshot.ts
new file mode 100644
index 00000000..95a83df9
--- /dev/null
+++ b/packages/github/src/pr-candidate-snapshot.ts
@@ -0,0 +1,222 @@
+import { z } from 'zod';
+import { defaultDeliveryCommandRunner, type DeliveryCommandRunner } from './delivery.js';
+
+const sha = z.string().regex(/^[a-f0-9]{40}$/);
+const inputSchema = z.object({
+  repo: z.string().regex(/^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}\/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$/),
+  pr: z.number().int().positive().max(2147483647),
+  expectedHead: sha.optional(), expectedBase: sha.optional(),
+  requiredChecks: z.array(z.string().min(1).max(256).refine(v => !/[\x00-\x1f\x7f]/.test(v))).max(100).optional(),
+}).strict().refine(v => (v.expectedHead === undefined) === (v.expectedBase === undefined))
+  .refine(v => new Set(v.requiredChecks ?? []).size === (v.requiredChecks ?? []).length);
+export type PrCandidateInput = z.infer<typeof inputSchema>;
+export function validatePrCandidateInput(input: unknown): PrCandidateInput {
+  const parsed = inputSchema.safeParse(input);
+  if (!parsed.success) throw new Error('invalid_input');
+  return parsed.data;
+}
+const factsSchema = z.object({
+  number: z.number().int(), url: z.string().url(), state: z.string(), isDraft: z.boolean(),
+  headRefOid: sha, baseRefOid: sha, headRefName: z.string().min(1), baseRefName: z.string().min(1),
+  mergeable: z.string(), mergeStateStatus: z.string(), reviewDecision: z.string().nullable(),
+});
+export type PrCandidateFacts = z.infer<typeof factsSchema>;
+const threadSchema = z.object({ id: z.string().min(1), isResolved: z.boolean(), isOutdated: z.boolean(), path: z.string(), line: z.number().int().nullable() });
+const checkSchema = z.discriminatedUnion('__typename', [
+  z.object({ __typename: z.literal('CheckRun'), id: z.string().min(1), name: z.string().min(1), status: z.string(), conclusion: z.string().nullable(), detailsUrl: z.string().nullable() }),
+  z.object({ __typename: z.literal('StatusContext'), id: z.string().min(1), context: z.string().min(1), state: z.string(), targetUrl: z.string().nullable() }),
+]);
+type CheckWire = z.infer<typeof checkSchema>;
+export type PrCandidateCheckState = 'success' | 'failure' | 'pending' | 'cancelled' | 'timed_out' | 'skipped' | 'neutral' | 'action_required' | 'unknown';
+export interface PrCandidateCheck { id: string; name: string; state: PrCandidateCheckState; raw: CheckWire }
+export interface PrCandidateQuery {
+  label: string; command: 'gh'; args: string[]; started_at: string; finished_at: string;
+  timeout_ms: number; exit_code: number | null; issue: string | null;
+}
+export interface PrCandidateRaw { label: string; stdout: string; stderr: string }
+interface Facet<T> { rows: T[]; complete: boolean; issue: string | null }
+export interface PrCandidateSnapshot {
+  schema_version: 1; repo: string; pr: number; started_at: string; finished_at: string;
+  initial: PrCandidateFacts | null; final: PrCandidateFacts | null;
+  binding: { status: 'stable' | 'changed' | 'unknown'; head: string | null; base: string | null; expected_head: string | null; expected_base: string | null };
+  checks: Facet<PrCandidateCheck> & { head: string | null; required: string[]; missing_required: string[]; ambiguous_required: string[] };
+  review: { decision: string | null; threads: Facet<z.infer<typeof threadSchema>>; unresolved: z.infer<typeof threadSchema>[]; approval_commit_binding: 'not_collected' };
+  blockers: string[]; waiting: string[]; unknowns: string[];
+  summary: 'blocked' | 'waiting' | 'no_observed_blocker' | 'unknown' | 'candidate_changed' | 'merged' | 'closed';
+  merge_authorized: false; requirements_basis: 'caller_declared' | 'unspecified';
+  forge_policy_coverage: 'not_collected'; evaluated_merge_commit: 'unknown';
+  limits: { max_requests: 8; pages_per_connection: 3; items_per_page: 100; request_timeout_ms: 10000; total_budget_ms: 90000; runner_stream_bytes: 16777216; accepted_json_bytes: 1048576 };
+  limitations: string[];
+}
+export interface PrCandidateObservation { snapshot: PrCandidateSnapshot; queries: PrCandidateQuery[]; raw: PrCandidateRaw[] }
+
+const factsQuery = `query CandidateFacts($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){nameWithOwner pullRequest(number:$number){number url state isDraft headRefOid baseRefOid headRefName baseRefName mergeable mergeStateStatus reviewDecision}}}`;
+const checksQuery = `query CandidateChecks($owner:String!,$name:String!,$oid:GitObjectID!,$after:String){repository(owner:$owner,name:$name){nameWithOwner object(oid:$oid){... on Commit{oid statusCheckRollup{contexts(first:100,after:$after){nodes{__typename ... on CheckRun{id name status conclusion detailsUrl} ... on StatusContext{id context state targetUrl}} pageInfo{hasNextPage endCursor}}}}}}}`;
+const threadsQuery = `query CandidateThreads($owner:String!,$name:String!,$number:Int!,$after:String){repository(owner:$owner,name:$name){nameWithOwner pullRequest(number:$number){number reviewThreads(first:100,after:$after){nodes{id isResolved isOutdated path line} pageInfo{hasNextPage endCursor}}}}}`;
+const pageSchema = z.object({ nodes: z.array(z.unknown()).max(100), pageInfo: z.object({ hasNextPage: z.boolean(), endCursor: z.string().nullable() }) });
+const record = (v: unknown): Record<string, unknown> => {
+  if (v === null || typeof v !== 'object' || Array.isArray(v)) throw new Error('invalid_response');
+  return v as Record<string, unknown>;
+};
+function checkState(row: CheckWire): PrCandidateCheckState {
+  if (row.__typename === 'StatusContext') {
+    if (row.state === 'SUCCESS') return 'success';
+    if (row.state === 'FAILURE' || row.state === 'ERROR') return 'failure';
+    return row.state === 'PENDING' ? 'pending' : 'unknown';
+  }
+  if (['QUEUED', 'IN_PROGRESS', 'WAITING', 'PENDING', 'REQUESTED'].includes(row.status) && row.conclusion === null) return 'pending';
+  if (row.status !== 'COMPLETED') return 'unknown';
+  switch (row.conclusion) {
+    case 'SUCCESS': return 'success';
+    case 'FAILURE': case 'STARTUP_FAILURE': case 'STALE': return 'failure';
+    case 'CANCELLED': return 'cancelled';
+    case 'TIMED_OUT': return 'timed_out';
+    case 'SKIPPED': return 'skipped';
+    case 'NEUTRAL': return 'neutral';
+    case 'ACTION_REQUIRED': return 'action_required';
+    default: return 'unknown';
+  }
+}
+
+/** A bracketed observation, not an atomic forge transaction or merge authorization. */
+export async function inspectPrCandidate(
+  input: PrCandidateInput,
+  runner: DeliveryCommandRunner = defaultDeliveryCommandRunner,
+  clock: () => number = Date.now,
+): Promise<PrCandidateObservation> {
+  const validated = validatePrCandidateInput(input);
+  const required = validated.requiredChecks ?? [];
+  const start = clock(), deadline = start + 90000;
+  const queries: PrCandidateQuery[] = [], raw: PrCandidateRaw[] = [];
+  const [owner, name] = validated.repo.split('/') as [string, string];
+  const iso = (time: number) => new Date(time).toISOString();
+  const read = async (label: string, query: string, variables: string[]): Promise<Record<string, unknown>> => {
+    const began = clock();
+    if (queries.length >= 8 || began >= deadline) throw new Error('budget_exhausted');
+    const timeout = Math.min(10000, deadline - began);
+    const args = ['api', 'graphql', '-f', `query=${query}`, '-f', `owner=${owner}`, '-f', `name=${name}`, ...variables];
+    const receipt: PrCandidateQuery = { label, command: 'gh', args, started_at: iso(began), finished_at: iso(began), timeout_ms: timeout, exit_code: null, issue: null };
+    queries.push(receipt);
+    try {
+      const result = await runner.run('gh', args, { cwd: process.cwd(), timeoutMs: timeout });
+      receipt.exit_code = result.exitCode;
+      raw.push({ label, stdout: result.stdout, stderr: result.stderr });
+      if (result.exitCode !== 0) throw new Error('command_failed');
+      if (clock() > deadline) throw new Error('budget_exhausted');
+      if (Buffer.byteLength(result.stdout) > 1048576) throw new Error('response_size');
+      let parsed: Record<string, unknown>;
+      try { parsed = record(JSON.parse(result.stdout)); } catch { throw new Error('invalid_json'); }
+      if (parsed.errors !== undefined) throw new Error('graphql_errors');
+      const repository = record(record(parsed.data).repository);
+      if (repository.nameWithOwner !== validated.repo) throw new Error('repository_mismatch');
+      return repository;
+    } catch (error) {
+      const allowed = ['command_failed', 'budget_exhausted', 'response_size', 'invalid_json', 'graphql_errors', 'repository_mismatch', 'invalid_response'];
+      receipt.issue = error instanceof Error && allowed.includes(error.message) ? error.message : 'runner_failed';
+      throw new Error(receipt.issue);
+    } finally { receipt.finished_at = iso(clock()); }
+  };
+  const readFacts = async (label: string) => {
+    const repository = await read(label, factsQuery, ['-F', `number=${validated.pr}`]);
+    const parsed = factsSchema.safeParse(repository.pullRequest);
+    if (!parsed.success || parsed.data.number !== validated.pr) throw new Error('pr_identity_unavailable');
+    return parsed.data;
+  };
+  const collect = async <T>(kind: 'checks' | 'threads', head: string, schema: z.ZodType<T>): Promise<Facet<T>> => {
+    const facet: Facet<T> = { rows: [], complete: false, issue: null };
+    const cursors = new Set<string>(), ids = new Set<string>();
+    let after: string | null = null;
+    try {
+      for (let i = 1; i <= 3; i++) {
+        const vars = kind === 'checks' ? ['-f', `oid=${head}`] : ['-F', `number=${validated.pr}`];
+        if (after !== null) vars.push('-f', `after=${after}`);
+        const repo = await read(`${kind}-${i}`, kind === 'checks' ? checksQuery : threadsQuery, vars);
+        let connection: unknown;
+        if (kind === 'checks') {
+          const commit = record(repo.object);
+          if (commit.oid !== head) throw new Error('head_mismatch');
+          connection = record(commit.statusCheckRollup).contexts;
+        } else {
+          const pr = record(repo.pullRequest);
+          if (pr.number !== validated.pr) throw new Error('pr_mismatch');
+          connection = pr.reviewThreads;
+        }
+        const parsed = pageSchema.safeParse(connection);
+        if (!parsed.success) throw new Error('invalid_page');
+        for (const item of parsed.data.nodes) {
+          const node = schema.safeParse(item);
+          if (!node.success) throw new Error('invalid_row');
+          const id = String(record(node.data).id);
+          if (ids.has(id)) throw new Error('duplicate_id');
+          ids.add(id); facet.rows.push(node.data);
+        }
+        if (!parsed.data.pageInfo.hasNextPage) { facet.complete = true; return facet; }
+        after = parsed.data.pageInfo.endCursor;
+        if (!after || cursors.has(after)) throw new Error('cursor_progress');
+        cursors.add(after);
+      }
+      facet.issue = 'page_limit';
+    } catch (error) { facet.issue = error instanceof Error ? error.message : 'collection_failed'; }
+    return facet;
+  };
+  let initial: PrCandidateFacts | null = null, final: PrCandidateFacts | null = null;
+  const unknowns: string[] = [], blockers: string[] = [], waiting: string[] = [];
+  let checkRows: Facet<CheckWire> = { rows: [], complete: false, issue: 'not_collected' };
+  let threadRows: Facet<z.infer<typeof threadSchema>> = { rows: [], complete: false, issue: 'not_collected' };
+  try { initial = await readFacts('initial'); } catch { unknowns.push('initial_identity_unavailable'); }
+  if (initial !== null) {
+    checkRows = await collect('checks', initial.headRefOid, checkSchema);
+    threadRows = await collect('threads', initial.headRefOid, threadSchema);
+    try { final = await readFacts('final'); } catch { unknowns.push('final_identity_unavailable'); }
+  }
+  let binding: 'stable' | 'changed' | 'unknown' = 'unknown';
+  if (initial && final) {
+    binding = ['headRefOid', 'baseRefOid', 'headRefName', 'baseRefName'].every(key => initial[key as keyof PrCandidateFacts] === final[key as keyof PrCandidateFacts]) ? 'stable' : 'changed';
+  }
+  if (initial && validated.expectedHead && (initial.headRefOid !== validated.expectedHead || initial.baseRefOid !== validated.expectedBase)) binding = 'changed';
+  const rows: PrCandidateCheck[] = checkRows.rows.map(row => ({ id: row.id, name: row.__typename === 'CheckRun' ? row.name : row.context, state: checkState(row), raw: row }));
+  const missing = required.filter(n => !rows.some(r => r.name === n));
+  const ambiguous = required.filter(n => rows.filter(r => r.name === n).length > 1);
+  if (!checkRows.complete) unknowns.push('checks_incomplete');
+  if (!threadRows.complete) unknowns.push('threads_incomplete');
+  if (missing.length) unknowns.push('required_checks_missing');
+  if (ambiguous.length) unknowns.push('required_checks_ambiguous');
+  if (!required.length) unknowns.push('requirements_unspecified');
+  // Non-required observed failures remain visible; they are not inferred required gates.
+  if (rows.some(r => ['failure', 'cancelled', 'timed_out', 'action_required'].includes(r.state))) blockers.push('check_failure');
+  if (rows.some(r => r.state === 'pending')) waiting.push('checks_pending');
+  if (rows.some(r => ['unknown', 'skipped', 'neutral'].includes(r.state))) unknowns.push('checks_not_success');
+  const unresolved = threadRows.rows.filter(t => !t.isResolved);
+  if (unresolved.length) blockers.push('unresolved_threads');
+  if (final) {
+    if (final.reviewDecision === 'CHANGES_REQUESTED') blockers.push('changes_requested');
+    else if (final.reviewDecision === 'REVIEW_REQUIRED') waiting.push('review_required');
+    else if (final.reviewDecision !== 'APPROVED') unknowns.push('review_decision_unknown');
+    if (final.mergeable === 'CONFLICTING' || final.mergeStateStatus === 'DIRTY') blockers.push('merge_conflict');
+    else if (final.mergeable !== 'MERGEABLE') unknowns.push('mergeability_unknown');
+    if (final.mergeStateStatus === 'BLOCKED') blockers.push('forge_blocked');
+    else if (['BEHIND', 'DRAFT'].includes(final.mergeStateStatus)) waiting.push('forge_waiting');
+    else if (!['CLEAN', 'DIRTY'].includes(final.mergeStateStatus)) unknowns.push('merge_state_unknown');
+    if (final.isDraft) waiting.push('draft');
+    if (!['OPEN', 'MERGED', 'CLOSED'].includes(final.state)) unknowns.push('pr_state_unknown');
+  }
+  let summary: PrCandidateSnapshot['summary'];
+  if (binding === 'changed') summary = 'candidate_changed';
+  else if (binding === 'unknown') summary = 'unknown';
+  else if (final?.state === 'MERGED') summary = 'merged';
+  else if (final?.state === 'CLOSED') summary = 'closed';
+  else if (blockers.length) summary = 'blocked';
+  else if (unknowns.length) summary = 'unknown';
+  else if (waiting.length) summary = 'waiting';
+  else summary = 'no_observed_blocker';
+  return { snapshot: {
+    schema_version: 1, repo: validated.repo, pr: validated.pr, started_at: iso(start), finished_at: iso(clock()), initial, final,
+    binding: { status: binding, head: initial?.headRefOid ?? null, base: initial?.baseRefOid ?? null, expected_head: validated.expectedHead ?? null, expected_base: validated.expectedBase ?? null },
+    checks: { rows, complete: checkRows.complete, issue: checkRows.issue, head: initial?.headRefOid ?? null, required, missing_required: missing, ambiguous_required: ambiguous },
+    review: { decision: final?.reviewDecision ?? null, threads: threadRows, unresolved, approval_commit_binding: 'not_collected' },
+    blockers, waiting, unknowns, summary, merge_authorized: false,
+    requirements_basis: required.length ? 'caller_declared' : 'unspecified', forge_policy_coverage: 'not_collected', evaluated_merge_commit: 'unknown',
+    limits: { max_requests: 8, pages_per_connection: 3, items_per_page: 100, request_timeout_ms: 10000, total_budget_ms: 90000, runner_stream_bytes: 16777216, accepted_json_bytes: 1048576 },
+    limitations: ['Non-atomic observations; checks and reviews may change after collection.', 'No branch protection, rulesets, merge queue or individual approval-commit qualification.', 'Read-only argv requests; no candidate execution, watcher, retries or merge authorization.', 'Runner injection is a test seam, not authenticated evidence. Raw metadata may be private.'],
+  }, queries, raw };
+}
diff --git a/scripts/report-pr-candidate.mjs b/scripts/report-pr-candidate.mjs
new file mode 100644
index 00000000..e78364d7
--- /dev/null
+++ b/scripts/report-pr-candidate.mjs
@@ -0,0 +1,89 @@
+#!/usr/bin/env node
+import { mkdir, realpath, writeFile, readFile, lstat } from 'node:fs/promises';
+import { realpathSync } from 'node:fs';
+import { dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createHash } from 'node:crypto';
+import { scratchRoot } from './lib/scratch.mjs';
+
+const help = `Read one GitHub PR candidate snapshot. This is not a merge authorization.
+Usage: node scripts/report-pr-candidate.mjs --repo OWNER/REPO --pr N --output ABSOLUTE_NEW_ROOT
+       [--expect-head SHA40 --expect-base SHA40] [--required-check NAME ...]
+The new output must be under OSSTACK_SCRATCH_ROOT. Its parent must exist.
+Exit 0: report written (may contain blockers or unknowns). Exit 2: invalid input/output.
+Exit 3: initial identity unavailable or report could not be written.
+No watcher, retry, candidate execution, approval, Ready mutation or merge.
+Required check names are caller-declared; forge policy is not collected.
+`;
+function parse(args) {
+  const values = new Map(), requiredChecks = [];
+  const allowed = ['--repo', '--pr', '--output', '--expect-head', '--expect-base', '--required-check'];
+  for (let i = 0; i < args.length; i += 2) {
+    const key = args[i], value = args[i + 1];
+    if (!allowed.includes(key) || typeof value !== 'string' || value.startsWith('--')) throw new Error('invalid_arguments');
+    if (key === '--required-check') requiredChecks.push(value);
+    else { if (values.has(key)) throw new Error('duplicate_argument'); values.set(key, value); }
+  }
+  if (!values.has('--repo') || !/^[1-9][0-9]*$/.test(values.get('--pr') ?? '') || !values.has('--output')) throw new Error('missing_arguments');
+  const input = { repo: values.get('--repo'), pr: Number(values.get('--pr')), requiredChecks };
+  if (values.has('--expect-head')) input.expectedHead = values.get('--expect-head');
+  if (values.has('--expect-base')) input.expectedBase = values.get('--expect-base');
+  return { input, output: values.get('--output') };
+}
+const within = (root, path) => { const rel = relative(root, path); return rel !== '' && rel !== '..' && !rel.startsWith(`..${sep}`) && !isAbsolute(rel); };
+const digest = bytes => createHash('sha256').update(bytes).digest('hex');
+
+/** The optional runner is an offline test seam, not a separate proof of forge identity. */
+export async function runPrCandidateReport(args, dependencies = {}) {
+  if (args.length === 1 && args[0] === '--help') return { exitCode: 0, help };
+  let prepared, library, output;
+  try {
+    prepared = parse(args);
+    library = await import('../packages/github/dist/pr-candidate-snapshot.js');
+    library.validatePrCandidateInput(prepared.input);
+    if (!isAbsolute(prepared.output)) throw new Error('absolute_output_required');
+    const root = await realpath(scratchRoot());
+    const parent = await realpath(dirname(resolve(prepared.output)));
+    output = join(parent, resolve(prepared.output).split(sep).at(-1));
+    if (!within(root, output)) throw new Error('output_outside_scratch');
+    // mkdir is exclusive: existing files, directories and terminal symlinks all refuse.
+    await mkdir(output, { mode: 0o700 });
+  } catch { return { exitCode: 2, error: 'input_or_output_refused' }; }
+  try {
+    const observation = await library.inspectPrCandidate(prepared.input, dependencies.runner, dependencies.clock);
+    await mkdir(join(output, 'raw'), { mode: 0o700 });
+    const files = [];
+    const write = async (path, content) => {
+      const bytes = Buffer.from(content);
+      await writeFile(join(output, path), bytes, { flag: 'wx', mode: 0o600 });
+      const retained = await readFile(join(output, path));
+      if (!retained.equals(bytes)) throw new Error('write_verification_failed');
+      files.push({ path, bytes: bytes.length, sha256: digest(bytes), mode: (await lstat(join(output, path))).mode & 0o777 });
+    };
+    await write('snapshot.json', `${JSON.stringify(observation.snapshot, null, 2)}\n`);
+    await write('queries.json', `${JSON.stringify(observation.queries, null, 2)}\n`);
+    for (const raw of observation.raw) {
+      // Labels are fixed by the collector; never use forge fields as filenames.
+      if (!/^(initial|final|checks-[1-3]|threads-[1-3])$/.test(raw.label)) throw new Error('invalid_raw_label');
+      await write(`raw/${raw.label}.stdout`, raw.stdout);
+      await write(`raw/${raw.label}.stderr`, raw.stderr);
+    }
+    const manifest = {
+      schema_version: 1, kind: 'pr_candidate_snapshot', repo: observation.snapshot.repo, pr: observation.snapshot.pr,
+      binding: observation.snapshot.binding, execution_path: dependencies.runner ? 'injected_runner' : 'default_delivery_runner',
+      files, merge_authorized: false, limitations: 'Hashes bind retained files only, not forge authenticity or an atomic transaction. No environment values are recorded.',
+    };
+    const manifestBytes = Buffer.from(`${JSON.stringify(manifest, null, 2)}\n`);
+    await writeFile(join(output, 'manifest.json'), manifestBytes, { flag: 'wx', mode: 0o600 });
+    if (!(await readFile(join(output, 'manifest.json'))).equals(manifestBytes)) throw new Error('manifest_write_failed');
+    return { exitCode: observation.snapshot.initial === null ? 3 : 0, output, summary: observation.snapshot.summary, merge_authorized: false, manifest_sha256: digest(manifestBytes) };
+  } catch { return { exitCode: 3, error: 'report_failed', output }; }
+}
+let direct = false;
+try { direct = process.argv[1] !== undefined && realpathSync(process.argv[1]) === fileURLToPath(import.meta.url); } catch { /* Importing the module does not execute it. */ }
+if (direct) {
+  const result = await runPrCandidateReport(process.argv.slice(2));
+  if (result.help) process.stdout.write(result.help);
+  else process.stdout.write(`${JSON.stringify(result)}\n`);
+  process.exitCode = result.exitCode;
+}
diff --git a/scripts/report-pr-candidate.test.mjs b/scripts/report-pr-candidate.test.mjs
new file mode 100644
index 00000000..3c7810a7
--- /dev/null
+++ b/scripts/report-pr-candidate.test.mjs
@@ -0,0 +1,103 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile, readdir, rm, mkdir, symlink, lstat } from 'node:fs/promises';
+import { join } from 'node:path';
+import { createHash } from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { createScratchDir } from './lib/scratch.mjs';
+import { runPrCandidateReport } from './report-pr-candidate.mjs';
+const H = 'a'.repeat(40), B = 'b'.repeat(40);
+const facts = { number: 7, url: 'https://github.com/owner/repo/pull/7', state: 'OPEN', isDraft: false, headRefOid: H, baseRefOid: B, headRefName: 'feature', baseRefName: 'main', mergeable: 'MERGEABLE', mergeStateStatus: 'CLEAN', reviewDecision: 'APPROVED' };
+function runner(mode = 'pass') {
+  const calls = [];
+  return { calls, async run(command, args) {
+    calls.push({ command, args });
+    if (mode === 'unavailable') return { stdout: '', stderr: 'fixture authentication unavailable', exitCode: 1 };
+    let repository = { nameWithOwner: 'owner/repo', pullRequest: facts };
+    const query = args.find(a => a.startsWith('query='));
+    if (query.includes('CandidateChecks')) repository = { nameWithOwner: 'owner/repo', object: { oid: H, statusCheckRollup: { contexts: { nodes: [{ __typename: 'CheckRun', id: 'c1', name: 'test', status: 'COMPLETED', conclusion: mode === 'blocked' ? 'FAILURE' : 'SUCCESS', detailsUrl: null }], pageInfo: { hasNextPage: false, endCursor: null } } } } };
+    if (query.includes('CandidateThreads')) repository = { nameWithOwner: 'owner/repo', pullRequest: { number: 7, reviewThreads: { nodes: [], pageInfo: { hasNextPage: false, endCursor: null } } } };
+    return { stdout: JSON.stringify({ data: { repository } }), stderr: '', exitCode: 0 };
+  } };
+}
+const args = output => ['--repo', 'owner/repo', '--pr', '7', '--output', output, '--required-check', 'test'];
+async function fixture(fn) {
+  const root = await createScratchDir('tests', 'pr-snapshot-script');
+  try { await fn(root); } finally { await rm(root, { recursive: true, force: true }); }
+}
+test('writes returned UTF-8 strings as receipts, manifest hashes and restrictive modes without mutation commands', () => fixture(async root => {
+  const output = join(root, 'report'), seam = runner();
+  const result = await runPrCandidateReport(args(output), { runner: seam });
+  assert.equal(result.exitCode, 0);
+  const snapshot = JSON.parse(await readFile(join(output, 'snapshot.json'), 'utf8'));
+  assert.equal(snapshot.summary, 'no_observed_blocker'); assert.equal(snapshot.merge_authorized, false);
+  const manifest = JSON.parse(await readFile(join(output, 'manifest.json'), 'utf8'));
+  assert.equal(manifest.execution_path, 'injected_runner'); assert.equal(manifest.files.length, 10);
+  for (const member of manifest.files) {
+    const bytes = await readFile(join(output, member.path));
+    assert.equal(bytes.length, member.bytes); assert.equal(createHash('sha256').update(bytes).digest('hex'), member.sha256);
+    assert.equal((await lstat(join(output, member.path))).mode & 0o777, 0o600);
+  }
+  assert.equal((await lstat(output)).mode & 0o777, 0o700);
+  assert.equal(seam.calls.length, 4);
+  assert.ok(seam.calls.every(c => c.command === 'gh' && c.args.slice(0, 2).join(' ') === 'api graphql'));
+}));
+test('an observed failure still exits zero for a written report, never authorizes merge', () => fixture(async root => {
+  const result = await runPrCandidateReport(args(join(root, 'report')), { runner: runner('blocked') });
+  assert.equal(result.exitCode, 0); assert.equal(result.summary, 'blocked');
+}));
+test('initial forge failure keeps raw failure and returns unavailable exit three', () => fixture(async root => {
+  const output = join(root, 'report'), seam = runner('unavailable');
+  const result = await runPrCandidateReport(args(output), { runner: seam });
+  assert.equal(result.exitCode, 3); assert.equal(result.summary, 'unknown'); assert.equal(seam.calls.length, 1);
+  assert.match(await readFile(join(output, 'raw/initial.stderr'), 'utf8'), /unavailable/);
+}));
+for (const [name, alter] of [
+  ['unknown flag', a => [...a, '--watch']], ['duplicate flag', a => [...a, '--pr', '8']],
+  ['invalid number', a => a.map(x => x === '7' ? '7x' : x)], ['one expected pin', a => [...a, '--expect-head', H]],
+  ['duplicate required name', a => [...a, '--required-check', 'test']],
+]) test(`preflight rejects ${name} before any forge request or output`, () => fixture(async root => {
+  const output = join(root, 'report'), seam = runner();
+  assert.equal((await runPrCandidateReport(alter(args(output)), { runner: seam })).exitCode, 2);
+  assert.equal(seam.calls.length, 0); assert.deepEqual(await readdir(root), []);
+}));
+test('existing output and terminal symlink refuse before calls and preserve contents', () => fixture(async root => {
+  const output = join(root, 'report'); await mkdir(output);
+  const seam = runner();
+  assert.equal((await runPrCandidateReport(args(output), { runner: seam })).exitCode, 2);
+  const link = join(root, 'link'); await symlink(output, link);
+  assert.equal((await runPrCandidateReport(args(link), { runner: seam })).exitCode, 2);
+  assert.equal(seam.calls.length, 0); assert.deepEqual(await readdir(output), []);
+}));
+test('relative output and missing outside parent refuse before calls', async () => {
+  const seam = runner();
+  for (const output of ['relative-output', '/not-the-scratch-root/pr-report']) assert.equal((await runPrCandidateReport(args(output), { runner: seam })).exitCode, 2);
+  assert.equal(seam.calls.length, 0);
+});
+
+for (const variant of ['existing-outside-parent', 'escaping-symlink-parent', 'scratch-root-itself']) {
+  test(`canonical containment refuses ${variant} before forge calls`, () => fixture(async owned => {
+    const narrow = join(owned, 'narrow'), outside = join(owned, 'outside');
+    await mkdir(narrow); await mkdir(outside);
+    await symlink(outside, join(narrow, 'escape'));
+    const saved = process.env.OSSTACK_SCRATCH_ROOT;
+    process.env.OSSTACK_SCRATCH_ROOT = narrow;
+    try {
+      const output = variant === 'existing-outside-parent' ? join(outside, 'report')
+        : variant === 'escaping-symlink-parent' ? join(narrow, 'escape', 'report') : narrow;
+      const seam = runner();
+      assert.equal((await runPrCandidateReport(args(output), { runner: seam })).exitCode, 2);
+      assert.equal(seam.calls.length, 0);
+      assert.deepEqual(await readdir(outside), []);
+      assert.deepEqual(await readdir(narrow), ['escape']);
+      assert.equal((await lstat(join(narrow, 'escape'))).isSymbolicLink(), true);
+    } finally {
+      if (saved === undefined) delete process.env.OSSTACK_SCRATCH_ROOT;
+      else process.env.OSSTACK_SCRATCH_ROOT = saved;
+    }
+  }));
+}
+test('real process help is build-independent and never reads forge', () => {
+  const result = spawnSync(process.execPath, ['scripts/report-pr-candidate.mjs', '--help'], { encoding: 'utf8' });
+  assert.equal(result.status, 0); assert.match(result.stdout, /not a merge authorization/);
+});
