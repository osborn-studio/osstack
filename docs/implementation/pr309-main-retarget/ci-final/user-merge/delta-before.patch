+    baseRefName: pr.baseRefName,
+    headRefName: pr.headRefName,
+    mergeable: "MERGEABLE",
+    mergeStateStatus: "CLEAN",
+    statusCheckRollup: [{ conclusion: "SUCCESS", status: "COMPLETED" }],
+    title: pr.title ?? `PR #${pr.number}`,
+    url: `https://github.com/o/r/pull/${pr.number}`,
+  });
