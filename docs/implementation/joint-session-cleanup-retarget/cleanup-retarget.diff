new file mode 100644
index 00000000..538d6b90
--- /dev/null
+++ b/.changeset/session-start-cleanup.md
@@ -0,0 +1,7 @@
+---
+"@osstack/cli": patch
+---
+
+Preserve completed Session start responses when writer lease cleanup fails. Clear the settled active-run marker while keeping retained admission visible to drain in the current daemon instance. Database-driven replay of the original start request does not start another Session.
+
+Retained-hold visibility across process restart is not verified. Recovery and drain visibility after process death remain pending in DEBT02. This change does not add a recovery API.
diff --git a/packages/cli/src/daemon.ts b/packages/cli/src/daemon.ts
index e074894e..46efc1b0 100644
--- a/packages/cli/src/daemon.ts
+++ b/packages/cli/src/daemon.ts
@@ -714,13 +714,18 @@ async function handleSessionStart(
     } catch { /* preserve the original bounded failure */ }
     return singleErr(req.id, "agent_failed", "agent failed while starting the session");
   } finally {
-    if (started && (!settled || controller.signal.aborted)) {
-      controller.abort();
-      if (await confirmAdapterStopped(adapter, runId)) await lease?.release();
-      else lease?.retain("session start exit unconfirmed");
-    } else await lease?.release();
-    ctx.activeRuns.delete(runId);
-    requestSupervisionScan(ctx, "session.start.settled");
+    try {
+      if (started && (!settled || controller.signal.aborted)) {
+        controller.abort();
+        if (await confirmAdapterStopped(adapter, runId)) await lease?.release();
+        else lease?.retain("session start exit unconfirmed");
+      } else await lease?.release();
+    } catch {
+      reportSessionCleanupFailure(sessionId, runId);
+    } finally {
+      if (ctx.activeRuns.get(runId) === controller) ctx.activeRuns.delete(runId);
+      requestSupervisionScan(ctx, "session.start.settled");
+    }
   }
 }
 
