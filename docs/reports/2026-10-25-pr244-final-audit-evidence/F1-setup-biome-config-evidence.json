{
  "repository": {
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "files": {
      "includes": [
        "packages/**/src/**/*.ts",
        "!**/dist",
        "!**/node_modules"
      ]
    },
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": true,
      "rules": {
        "recommended": true,
        "complexity": {
          "noForEach": "off",
          "useLiteralKeys": "off"
        },
        "style": {
          "noNonNullAssertion": "off",
          "useTemplate": "off"
        }
      }
    },
    "assist": {
      "enabled": false
    }
  },
  "checked_config": {
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "files": {
      "includes": [
        "**/*.ts"
      ]
    },
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": true,
      "rules": {
        "recommended": true,
        "complexity": {
          "noForEach": "off",
          "useLiteralKeys": "off"
        },
        "style": {
          "noNonNullAssertion": "off",
          "useTemplate": "off"
        }
      }
    },
    "assist": {
      "enabled": false
    }
  },
  "differences": {
    "files": {
      "original": {
        "includes": [
          "packages/**/src/**/*.ts",
          "!**/dist",
          "!**/node_modules"
        ]
      },
      "explicit": {
        "includes": [
          "**/*.ts"
        ]
      }
    }
  }
}